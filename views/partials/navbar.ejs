            <li><a href="/restaurants/<%=currentUser._id%>/donations">Donations</a></li>
            <li><a href="/restaurants/<%=currentUser._id%>/donations/history">Donation History</a></li>
            <li><a href="/orderhistory">Order History</a></li>
            <li><a href="/profile/<%= currentUser._id %>">Profile</a></li>
        <% } else if(currentUser.roles === 'NGO') { %>
            <li><a href="/ngo/dashboard">Dashboard</a></li>
            <li><a href="/receiveddonations">Received Donations</a></li>
            <li><a href="/donationhistory">Donation History</a></li>
