<% layout('layouts/adminBoilerplate') %>
<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Users Management</h1>
    <a href="/admin" class="btn btn-outline-primary">Back to Dashboard</a>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Location</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
        <tr>
          <td><%= user.username %></td>
          <td><%= user.email %></td>
          <td><%= user.roles %></td>
          <td><%= user.location %></td>
          <td>
            <% if (user.isOpen) { %>
              <span class="badge bg-success">Enabled</span>
            <% } else { %>
              <span class="badge bg-secondary">Disabled</span>
            <% } %>
          </td>
          <td>
            <a href="/admin/users/<%= user._id %>" class="btn btn-sm btn-primary">View</a>
            <form action="/admin/users/<%= user._id %>/toggle" method="POST" class="d-inline">
              <button class="btn btn-sm <%= user.isOpen ? 'btn-warning' : 'btn-success' %>">
                <%= user.isOpen ? 'Disable' : 'Enable' %>
              </button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
