<% layout('layouts/adminBoilerplate') %>
<%
  const getRoleClass = (role) => {
    if (role === 'restaurant') return 'role-badge-restaurant';
    if (role === 'NGO') return 'role-badge-ngo';
    if (role === 'Admin') return 'role-badge-admin';
    return 'role-badge-customer';
  };

  const getRoleLabel = (role) => {
    if (role === 'restaurant') return 'Restaurant';
    if (role === 'NGO') return 'NGO';
    if (role === 'Admin') return 'Admin';
    return 'Customer';
  };

  const userCount = Array.isArray(users) ? users.length : 0;
%>

<div class="admin-users-page">
  <section class="users-hero card admin-glass-card mb-4">
    <div class="card-body p-4 p-lg-5">
      <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-4">
        <div>
          <div class="users-hero-kicker mb-2">
            <i class="bi bi-people-fill"></i>
            <span>FoodBridge User Center</span>
          </div>
          <h1 class="users-page-title mb-2">Users Management</h1>
          <p class="users-page-subtitle mb-0">Manage all platform users from one place with search, filters, and quick actions.</p>
        </div>
        <a href="/admin" class="btn admin-outline-btn">
          <i class="bi bi-arrow-left me-2"></i>
          Back to Dashboard
        </a>
      </div>
    </div>
  </section>

  <section class="card users-toolbar-card mb-4">
    <div class="card-body p-3 p-lg-4">
      <div class="row g-3 align-items-center">
        <div class="col-xl-5">
          <label for="usersSearchInput" class="form-label users-toolbar-label mb-2">Search users</label>
          <div class="input-group users-search-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="usersSearchInput" class="form-control" placeholder="Search by username or email">
            <button class="btn btn-outline-secondary" type="button" id="usersClearSearch">Clear</button>
          </div>
        </div>
        <div class="col-xl-7">
          <div class="users-toolbar-label mb-2 d-none d-xl-block">Filter by role</div>
          <div class="users-filter-group" id="usersFilterGroup">
            <button type="button" class="users-filter-btn active" data-filter="all">All Users</button>
            <button type="button" class="users-filter-btn" data-filter="customer">Customers</button>
            <button type="button" class="users-filter-btn" data-filter="restaurant">Restaurants</button>
            <button type="button" class="users-filter-btn" data-filter="NGO">NGOs</button>
            <button type="button" class="users-filter-btn" data-filter="Admin">Admins</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="users-table-card card">
    <div class="card-body p-0">
      <div class="users-table-header px-4 py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
          <h2 class="users-table-title mb-1">Registered Users</h2>
          <p class="users-table-subtitle mb-0"><%= userCount %> users available in the system.</p>
        </div>
        <div class="users-table-legend d-flex flex-wrap gap-2">
          <span class="legend-pill legend-pill-blue"><i class="bi bi-dot"></i> Customer</span>
          <span class="legend-pill legend-pill-orange"><i class="bi bi-dot"></i> Restaurant</span>
          <span class="legend-pill legend-pill-green"><i class="bi bi-dot"></i> NGO</span>
          <span class="legend-pill legend-pill-dark"><i class="bi bi-dot"></i> Admin</span>
        </div>
      </div>

      <% if (users && users.length) { %>
        <div class="table-responsive users-table-responsive">
          <table class="table align-middle mb-0 users-table">
            <thead>
              <tr>
                <th>Profile</th>
                <th>Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Joined Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="usersTableBody">
              <% users.forEach(user => { %>
                <tr
                  class="users-row"
                  data-role="<%= user.roles %>"
                  data-search="<%= `${user.username || ''} ${user.email || ''}`.toLowerCase() %>"
                >
                  <td>
                    <div class="user-avatar-wrap">
                      <img
                        src="<%= user.image && user.image.url ? user.image.url : 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png' %>"
                        alt="<%= user.username %>"
                        class="user-avatar"
                      />
                    </div>
                  </td>
                  <td>
                    <div class="user-name-cell">
                      <strong><%= user.username %></strong>
                      <span><%= user.location || 'No location provided' %></span>
                    </div>
                  </td>
                  <td><span class="user-mono"><%= user.username %></span></td>
                  <td><a href="mailto:<%= user.email %>" class="user-email-link"><%= user.email %></a></td>
                  <td>
                    <span class="role-badge <%= getRoleClass(user.roles) %>"><%= getRoleLabel(user.roles) %></span>
                  </td>
                  <td>
                    <% if (user.isOpen) { %>
                      <span class="status-badge status-badge-enabled"><i class="bi bi-check-circle-fill me-1"></i>Enabled</span>
                    <% } else { %>
                      <span class="status-badge status-badge-disabled"><i class="bi bi-dash-circle-fill me-1"></i>Disabled</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="joined-cell">
                      <i class="bi bi-calendar3"></i>
                      <span><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A' %></span>
                    </div>
                  </td>
                  <td>
                    <div class="users-actions">
                      <a href="/admin/users/<%= user._id %>" class="btn btn-sm users-action-btn users-action-view">
                        <i class="bi bi-eye"></i>
                        <span>View</span>
                      </a>
                      <button type="button" class="btn btn-sm users-action-btn users-action-edit" disabled title="Edit UI not connected to backend">
                        <i class="bi bi-pencil-square"></i>
                        <span>Edit</span>
                      </button>
                      <button type="button" class="btn btn-sm users-action-btn users-action-delete" disabled title="Delete UI not connected to backend">
                        <i class="bi bi-trash3"></i>
                        <span>Delete</span>
                      </button>
                      <form action="/admin/users/<%= user._id %>/toggle" method="POST" class="d-inline users-toggle-form">
                        <button class="btn btn-sm users-action-btn users-action-toggle" title="Toggle status">
                          <i class="bi <%= user.isOpen ? 'bi-slash-circle' : 'bi-check2-circle' %>"></i>
                          <span><%= user.isOpen ? 'Disable' : 'Enable' %></span>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div id="usersEmptyState" class="users-empty-state d-none">
          <div class="users-empty-icon"><i class="bi bi-search-heart"></i></div>
          <h3>No matching users found</h3>
          <p>Try a different username, email, or switch back to All Users.</p>
        </div>
      <% } else { %>
        <div class="users-empty-state">
          <div class="users-empty-icon"><i class="bi bi-people"></i></div>
          <h3>No users available</h3>
          <p>When users register, they will appear here with their profile, role, and status.</p>
        </div>
      <% } %>
    </div>
  </section>
</div>

<script>
  (function () {
    const searchInput = document.getElementById('usersSearchInput');
    const clearButton = document.getElementById('usersClearSearch');
    const filterGroup = document.getElementById('usersFilterGroup');
    const rows = Array.from(document.querySelectorAll('.users-row'));
    const emptyState = document.getElementById('usersEmptyState');

    if (!searchInput || !filterGroup || !rows.length) return;

    let activeFilter = 'all';

    const normalize = (value) => (value || '').trim().toLowerCase();

    const updateEmptyState = (visibleCount) => {
      if (!emptyState) return;
      emptyState.classList.toggle('d-none', visibleCount !== 0);
    };

    const applyFilters = () => {
      const query = normalize(searchInput.value);
      let visibleCount = 0;

      rows.forEach((row) => {
        const role = row.dataset.role || '';
        const searchable = row.dataset.search || '';
        const matchesRole = activeFilter === 'all' || role === activeFilter;
        const matchesQuery = !query || searchable.includes(query);
        const shouldShow = matchesRole && matchesQuery;

        row.classList.toggle('d-none', !shouldShow);
        if (shouldShow) visibleCount += 1;
      });

      updateEmptyState(visibleCount);
    };

    filterGroup.addEventListener('click', (event) => {
      const button = event.target.closest('.users-filter-btn');
      if (!button) return;

      activeFilter = button.dataset.filter || 'all';

      filterGroup.querySelectorAll('.users-filter-btn').forEach((item) => {
        item.classList.toggle('active', item === button);
      });

      applyFilters();
    });

    searchInput.addEventListener('input', applyFilters);

    if (clearButton) {
      clearButton.addEventListener('click', () => {
        searchInput.value = '';
        applyFilters();
        searchInput.focus();
      });
    }

    applyFilters();
  })();
</script>
