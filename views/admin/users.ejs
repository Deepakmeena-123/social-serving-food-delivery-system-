<% layout('layouts/adminBoilerplate') %>

<div class="admin-users-clean">

    <!-- PAGE HEADER -->
    <section class="users-clean-header">

        <div>

            <span class="users-clean-kicker">
                <i class="bi bi-people-fill"></i>
                User Management
            </span>

            <h1 class="users-clean-title">
                Users
            </h1>

            <p class="users-clean-subtitle">
                View and manage registered users on FoodBridge.
            </p>

        </div>

    </section>


    <!-- SEARCH AND FILTER -->
    <section class="users-control-card">

        <div class="users-search-wrapper">

            <label
                for="usersSearchInput"
                class="users-control-label"
            >
                Search Users
            </label>

            <div class="users-search-box">

                <i class="bi bi-search"></i>

                <input
                    type="text"
                    id="usersSearchInput"
                    class="users-search-input"
                    placeholder="Search by username or email..."
                    autocomplete="off"
                >

                <button
                    type="button"
                    id="usersClearSearch"
                    class="users-clear-btn"
                >
                    Clear
                </button>

            </div>

        </div>


        <div class="users-filter-wrapper">

            <span class="users-control-label">
                Filter by Role
            </span>

            <div
                class="users-filter-group"
                id="usersFilterGroup"
            >

                <button
                    type="button"
                    class="users-filter-btn active"
                    data-filter="all"
                >
                    All
                </button>

                <button
                    type="button"
                    class="users-filter-btn"
                    data-filter="customer"
                >
                    Customers
                </button>

                <button
                    type="button"
                    class="users-filter-btn"
                    data-filter="restaurant"
                >
                    Restaurants
                </button>

                <button
                    type="button"
                    class="users-filter-btn"
                    data-filter="NGO"
                >
                    NGOs
                </button>

                <button
                    type="button"
                    class="users-filter-btn"
                    data-filter="Admin"
                >
                    Admins
                </button>

            </div>

        </div>

    </section>


    <!-- USER LIST -->
    <section class="users-list-card">

        <!-- LIST HEADER -->
        <div class="users-list-header">

            <div>

                <h2>
                    Registered Users
                </h2>

                <p>
                    <span id="visibleUsersCount">
                        <%= users ? users.length : 0 %>
                    </span>

                    user(s) found
                </p>

            </div>

            <div class="users-list-info">

                <i class="bi bi-info-circle"></i>

                <span>
                    View or change account status
                </span>

            </div>

        </div>


        <!-- USERS EXIST -->
        <% if (users && users.length > 0) { %>


            <div class="table-responsive users-table-wrapper">

                <table class="users-clean-table">

                    <thead>

                        <tr>

                            <th>
                                User
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Joined
                            </th>

                            <th class="users-action-column">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="usersTableBody">


                        <% users.forEach(user => { %>

                            <tr
                                class="users-clean-row"
                                data-role="<%= user.roles %>"
                                data-search="<%= (user.username || '') + ' ' + (user.email || '') %>"
                            >


                                <!-- USER -->

                                <td>

                                    <div class="users-user-cell">

                                        <div class="users-avatar">

                                            <img
                                                src="<%= user.image && user.image.url
                                                    ? user.image.url
                                                    : 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png'
                                                %>"
                                                alt="<%= user.username %>"
                                            >

                                        </div>


                                        <div class="users-user-info">

                                            <strong>
                                                <%= user.username %>
                                            </strong>

                                            <span>
                                                <%= user.location || 'Location not provided' %>
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    <a
                                        href="mailto:<%= user.email %>"
                                        class="users-email"
                                    >
                                        <%= user.email %>
                                    </a>

                                </td>


                                <!-- ROLE -->

                                <td>

                                    <% if (user.roles === 'restaurant') { %>

                                        <span class="users-role-badge role-badge-restaurant">
                                            Restaurant
                                        </span>

                                    <% } else if (user.roles === 'NGO') { %>

                                        <span class="users-role-badge role-badge-ngo">
                                            NGO
                                        </span>

                                    <% } else if (user.roles === 'Admin') { %>

                                        <span class="users-role-badge role-badge-admin">
                                            Admin
                                        </span>

                                    <% } else { %>

                                        <span class="users-role-badge role-badge-customer">
                                            Customer
                                        </span>

                                    <% } %>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <% if (user.isOpen) { %>

                                        <span class="users-status users-status-active">

                                            <span class="users-status-dot"></span>

                                            Enabled

                                        </span>

                                    <% } else { %>

                                        <span class="users-status users-status-disabled">

                                            <span class="users-status-dot"></span>

                                            Disabled

                                        </span>

                                    <% } %>

                                </td>


                                <!-- JOINED DATE -->

                                <td>

                                    <span class="users-date">

                                        <i class="bi bi-calendar3"></i>

                                        <%= user.createdAt
                                            ? new Date(user.createdAt).toLocaleDateString(
                                                'en-IN',
                                                {
                                                    year: 'numeric',
                                                    month: 'short',
                                                    day: 'numeric'
                                                }
                                            )
                                            : 'N/A'
                                        %>

                                    </span>

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="users-actions">


                                        <!-- VIEW USER -->

                                        <a
                                            href="/admin/users/<%= user._id %>"
                                            class="users-view-btn"
                                            title="View user"
                                        >

                                            <i class="bi bi-eye"></i>

                                            <span>
                                                View
                                            </span>

                                        </a>


                                        <!-- ENABLE / DISABLE -->

                                        <form
                                            action="/admin/users/<%= user._id %>/toggle"
                                            method="POST"
                                            class="users-toggle-form"
                                        >

                                            <button
                                                type="submit"
                                                class="users-toggle-btn <%= user.isOpen
                                                    ? 'users-disable-btn'
                                                    : 'users-enable-btn'
                                                %>"
                                            >

                                                <% if (user.isOpen) { %>

                                                    <i class="bi bi-person-dash"></i>

                                                    <span>
                                                        Disable
                                                    </span>

                                                <% } else { %>

                                                    <i class="bi bi-person-check"></i>

                                                    <span>
                                                        Enable
                                                    </span>

                                                <% } %>

                                            </button>

                                        </form>


                                    </div>

                                </td>


                            </tr>

                        <% }) %>


                    </tbody>

                </table>

            </div>


            <!-- SEARCH EMPTY STATE -->

            <div
                id="usersEmptyState"
                class="users-empty-state d-none"
            >

                <div class="users-empty-icon">

                    <i class="bi bi-search"></i>

                </div>

                <h3>
                    No users found
                </h3>

                <p>
                    Try another username, email address, or role.
                </p>

                <button
                    type="button"
                    id="usersResetFilters"
                    class="users-reset-btn"
                >
                    Reset Filters
                </button>

            </div>


        <% } else { %>


            <!-- NO USERS -->

            <div class="users-empty-state">

                <div class="users-empty-icon">

                    <i class="bi bi-people"></i>

                </div>

                <h3>
                    No users available
                </h3>

                <p>
                    Registered users will appear here.
                </p>

            </div>


        <% } %>


    </section>

</div>



<!-- =====================================================
     SEARCH AND FILTER JAVASCRIPT
     ===================================================== -->

<script>

(function () {

    'use strict';


    const searchInput =
        document.getElementById(
            'usersSearchInput'
        );


    const clearButton =
        document.getElementById(
            'usersClearSearch'
        );


    const filterGroup =
        document.getElementById(
            'usersFilterGroup'
        );


    const rows =
        Array.from(
            document.querySelectorAll(
                '.users-clean-row'
            )
        );


    const emptyState =
        document.getElementById(
            'usersEmptyState'
        );


    const resetButton =
        document.getElementById(
            'usersResetFilters'
        );


    const visibleUsersCount =
        document.getElementById(
            'visibleUsersCount'
        );


    if (
        !searchInput ||
        !filterGroup
    ) {
        return;
    }


    let activeFilter = 'all';


    function normalize(value) {

        return String(value || '')
            .trim()
            .toLowerCase();

    }


    function applyFilters() {

        const searchText =
            normalize(
                searchInput.value
            );


        let visibleCount = 0;


        rows.forEach(function (row) {

            const role =
                row.dataset.role || '';


            const searchData =
                normalize(
                    row.dataset.search
                );


            const roleMatches =
                activeFilter === 'all' ||
                role === activeFilter;


            const searchMatches =
                searchText === '' ||
                searchData.includes(
                    searchText
                );


            const shouldShow =
                roleMatches &&
                searchMatches;


            row.classList.toggle(
                'd-none',
                !shouldShow
            );


            if (shouldShow) {

                visibleCount++;

            }

        });


        if (visibleUsersCount) {

            visibleUsersCount.textContent =
                visibleCount;

        }


        if (emptyState) {

            emptyState.classList.toggle(
                'd-none',
                visibleCount !== 0
            );

        }

    }


    /* ROLE FILTER */

    filterGroup.addEventListener(
        'click',
        function (event) {

            const button =
                event.target.closest(
                    '.users-filter-btn'
                );


            if (!button) {
                return;
            }


            activeFilter =
                button.dataset.filter ||
                'all';


            const buttons =
                filterGroup.querySelectorAll(
                    '.users-filter-btn'
                );


            buttons.forEach(
                function (item) {

                    item.classList.toggle(
                        'active',
                        item === button
                    );

                }
            );


            applyFilters();

        }
    );


    /* SEARCH */

    searchInput.addEventListener(
        'input',
        applyFilters
    );


    /* CLEAR SEARCH */

    if (clearButton) {

        clearButton.addEventListener(
            'click',
            function () {

                searchInput.value = '';

                applyFilters();

                searchInput.focus();

            }
        );

    }


    /* RESET FILTERS */

    if (resetButton) {

        resetButton.addEventListener(
            'click',
            function () {

                searchInput.value = '';

                activeFilter = 'all';


                const buttons =
                    filterGroup.querySelectorAll(
                        '.users-filter-btn'
                    );


                buttons.forEach(
                    function (button) {

                        button.classList.toggle(
                            'active',
                            button.dataset.filter === 'all'
                        );

                    }
                );


                applyFilters();

            }
        );

    }


    /* INITIAL FILTER */

    applyFilters();


})();

</script>