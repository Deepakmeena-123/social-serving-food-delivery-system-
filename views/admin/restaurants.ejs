<% layout('layouts/adminBoilerplate') %>

<%
  const restaurantsList = Array.isArray(restaurants) ? restaurants : [];

  const totalRestaurants = restaurantsList.length;

  const activeRestaurants = restaurantsList.filter(
    (restaurant) => restaurant.isOpen
  ).length;

  const inactiveRestaurants = totalRestaurants - activeRestaurants;

  const defaultRestaurantImage =
    'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png';

  const getRestaurantImage = (restaurant) => {
    if (
      restaurant &&
      restaurant.image &&
      restaurant.image.url
    ) {
      return restaurant.image.url;
    }

    return defaultRestaurantImage;
  };

  const getRestaurantName = (restaurant) => {
    if (!restaurant) return 'Unnamed Restaurant';

    return (
      restaurant.ownerName ||
      restaurant.contactName ||
      restaurant.username ||
      'Unnamed Restaurant'
    );
  };

  const getRestaurantOwner = (restaurant) => {
    if (!restaurant) return 'Owner not available';

    return (
      restaurant.ownerName ||
      restaurant.contactName ||
      restaurant.username ||
      'Owner not available'
    );
  };

  const getSearchText = (restaurant) => {
    if (!restaurant) return '';

    return [
      restaurant.username,
      restaurant.ownerName,
      restaurant.contactName,
      restaurant.email,
      restaurant.location,
      restaurant.contactNumber
    ]
      .filter(Boolean)
      .join(' ')
      .toLowerCase();
  };
%>


<div class="restaurant-management-page">

  <!-- =====================================================
       PAGE HEADER
       ===================================================== -->

  <section class="restaurant-management-header">

    <div>
      <div class="restaurant-management-kicker">
        <i class="bi bi-shop"></i>
        <span>Restaurant Management</span>
      </div>

      <h1>Restaurants</h1>

      <p>
        Manage registered restaurants, review their details,
        and control their availability.
      </p>
    </div>

  </section>


  <!-- =====================================================
       SUMMARY CARDS
       ===================================================== -->

  <section class="restaurant-summary-grid">

    <div class="restaurant-summary-card">
      <div class="restaurant-summary-icon">
        <i class="bi bi-shop-window"></i>
      </div>

      <div>
        <span>Total Restaurants</span>
        <strong><%= totalRestaurants %></strong>
      </div>
    </div>


    <div class="restaurant-summary-card restaurant-summary-active">
      <div class="restaurant-summary-icon">
        <i class="bi bi-check-circle"></i>
      </div>

      <div>
        <span>Active</span>
        <strong><%= activeRestaurants %></strong>
      </div>
    </div>


    <div class="restaurant-summary-card restaurant-summary-inactive">
      <div class="restaurant-summary-icon">
        <i class="bi bi-dash-circle"></i>
      </div>

      <div>
        <span>Inactive</span>
        <strong><%= inactiveRestaurants %></strong>
      </div>
    </div>

  </section>


  <!-- =====================================================
       SEARCH + FILTER
       ===================================================== -->

  <section class="restaurant-management-controls">

    <div class="restaurant-search-wrapper">

      <label for="restaurantSearchInput">
        Search Restaurants
      </label>

      <div class="restaurant-search-box">

        <i class="bi bi-search"></i>

        <input
          type="text"
          id="restaurantSearchInput"
          placeholder="Search by restaurant, owner, email or location..."
          autocomplete="off"
        />

        <button
          type="button"
          id="restaurantClearSearch"
          class="restaurant-clear-search"
        >
          Clear
        </button>

      </div>

    </div>


    <div class="restaurant-filter-wrapper">

      <span>Filter</span>

      <div
        class="restaurant-filter-buttons"
        id="restaurantFilterButtons"
      >

        <button
          type="button"
          class="restaurant-filter-button active"
          data-filter="all"
        >
          All
          <span><%= totalRestaurants %></span>
        </button>

        <button
          type="button"
          class="restaurant-filter-button"
          data-filter="active"
        >
          Active
          <span><%= activeRestaurants %></span>
        </button>

        <button
          type="button"
          class="restaurant-filter-button"
          data-filter="inactive"
        >
          Inactive
          <span><%= inactiveRestaurants %></span>
        </button>

      </div>

    </div>

  </section>


  <!-- =====================================================
       RESTAURANT LIST
       ===================================================== -->

  <section class="restaurant-list-card">

    <div class="restaurant-list-header">

      <div>
        <h2>Registered Restaurants</h2>

        <p>
          Review restaurant accounts and manage their availability.
        </p>
      </div>

      <div class="restaurant-result-count">
        <i class="bi bi-shop"></i>

        <span id="restaurantResultCount">
          <%= totalRestaurants %>
        </span>

        <span>restaurants</span>
      </div>

    </div>


    <% if (restaurantsList.length > 0) { %>

      <div class="restaurant-table-wrapper">

        <table class="restaurant-management-table">

          <thead>
            <tr>
              <th>Restaurant</th>
              <th>Owner</th>
              <th>Contact</th>
              <th>Location</th>
              <th>Status</th>
              <th class="restaurant-actions-heading">
                Actions
              </th>
            </tr>
          </thead>


          <tbody id="restaurantTableBody">

            <% restaurantsList.forEach((restaurant) => { %>

              <tr
                class="restaurant-management-row"
                data-status="<%= restaurant.isOpen ? 'active' : 'inactive' %>"
                data-search="<%= getSearchText(restaurant) %>"
              >

                <!-- Restaurant -->
                <td>

                  <div class="restaurant-main-info">

                    <div class="restaurant-management-image">

                      <img
                        src="<%= getRestaurantImage(restaurant) %>"
                        alt="<%= getRestaurantName(restaurant) %>"
                      />

                    </div>


                    <div class="restaurant-name-info">

                      <strong>
                        <%= getRestaurantName(restaurant) %>
                      </strong>

                      <span>
                        <%=
                          restaurant.username ||
                          'Restaurant account'
                        %>
                      </span>

                    </div>

                  </div>

                </td>


                <!-- Owner -->
                <td>

                  <div class="restaurant-owner-info">

                    <strong>
                      <%= getRestaurantOwner(restaurant) %>
                    </strong>

                    <span>
                      <i class="bi bi-person"></i>
                      Owner
                    </span>

                  </div>

                </td>


                <!-- Contact -->
                <td>

                  <div class="restaurant-contact-info">

                    <% if (restaurant.email) { %>

                      <a
                        href="mailto:<%= restaurant.email %>"
                        class="restaurant-email"
                      >
                        <i class="bi bi-envelope"></i>
                        <%= restaurant.email %>
                      </a>

                    <% } else { %>

                      <span class="restaurant-not-available">
                        Email not available
                      </span>

                    <% } %>


                    <% if (restaurant.contactNumber) { %>

                      <span class="restaurant-phone">
                        <i class="bi bi-telephone"></i>
                        <%= restaurant.contactNumber %>
                      </span>

                    <% } %>

                  </div>

                </td>


                <!-- Location -->
                <td>

                  <div class="restaurant-location">

                    <i class="bi bi-geo-alt"></i>

                    <span>
                      <%= restaurant.location || 'Location not provided' %>
                    </span>

                  </div>

                </td>


                <!-- Status -->
                <td>

                  <% if (restaurant.isOpen) { %>

                    <span class="restaurant-status active">
                      <span class="restaurant-status-dot"></span>
                      Active
                    </span>

                  <% } else { %>

                    <span class="restaurant-status inactive">
                      <span class="restaurant-status-dot"></span>
                      Inactive
                    </span>

                  <% } %>

                </td>


                <!-- Actions -->
                <td>

                  <div class="restaurant-management-actions">

                    <!-- View -->
                    <a
                      href="/admin/restaurants/<%= restaurant._id %>"
                      class="restaurant-view-button"
                      title="View restaurant details"
                    >
                      <i class="bi bi-eye"></i>
                      <span>View</span>
                    </a>


                    <!-- Enable / Disable -->
                    <form
                      action="/admin/restaurants/<%= restaurant._id %>/toggle"
                      method="POST"
                      class="restaurant-toggle-form"
                    >

                      <% if (restaurant.isOpen) { %>

                        <button
                          type="submit"
                          class="restaurant-toggle-button disable"
                          title="Disable restaurant"
                        >
                          <i class="bi bi-slash-circle"></i>
                          <span>Disable</span>
                        </button>

                      <% } else { %>

                        <button
                          type="submit"
                          class="restaurant-toggle-button enable"
                          title="Enable restaurant"
                        >
                          <i class="bi bi-check-circle"></i>
                          <span>Enable</span>
                        </button>

                      <% } %>

                    </form>

                  </div>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>


      <!-- Empty result after search/filter -->
      <div
        id="restaurantEmptySearchState"
        class="restaurant-empty-state"
        style="display: none;"
      >

        <div class="restaurant-empty-icon">
          <i class="bi bi-search"></i>
        </div>

        <h3>No restaurants found</h3>

        <p>
          No restaurant matches your current search or filter.
        </p>

        <button
          type="button"
          id="restaurantResetFilters"
          class="restaurant-reset-button"
        >
          Reset Filters
        </button>

      </div>


    <% } else { %>


      <!-- No restaurants in database -->
      <div class="restaurant-empty-state">

        <div class="restaurant-empty-icon">
          <i class="bi bi-shop-window"></i>
        </div>

        <h3>No restaurants available</h3>

        <p>
          Registered restaurants will appear here when they
          join the FoodBridge platform.
        </p>

      </div>


    <% } %>

  </section>

</div>


<!-- =====================================================
     SEARCH + FILTER JAVASCRIPT
     ===================================================== -->

<script>

  (function () {

    const searchInput =
      document.getElementById('restaurantSearchInput');

    const clearButton =
      document.getElementById('restaurantClearSearch');

    const filterButtons =
      document.getElementById('restaurantFilterButtons');

    const rows =
      Array.from(
        document.querySelectorAll('.restaurant-management-row')
      );

    const emptyState =
      document.getElementById('restaurantEmptySearchState');

    const resultCount =
      document.getElementById('restaurantResultCount');

    const resetButton =
      document.getElementById('restaurantResetFilters');


    if (!searchInput || !filterButtons || !rows.length) {
      return;
    }


    let activeFilter = 'all';


    const normalize = (value) => {
      return (value || '').trim().toLowerCase();
    };


    const updateResults = () => {

      const query =
        normalize(searchInput.value);

      let visibleCount = 0;


      rows.forEach((row) => {

        const status =
          row.dataset.status || 'inactive';

        const searchable =
          row.dataset.search || '';

        const matchesSearch =
          !query || searchable.includes(query);

        const matchesFilter =
          activeFilter === 'all' ||
          status === activeFilter;

        const shouldShow =
          matchesSearch && matchesFilter;


        row.style.display =
          shouldShow ? '' : 'none';


        if (shouldShow) {
          visibleCount++;
        }

      });


      if (resultCount) {
        resultCount.textContent = visibleCount;
      }


      if (emptyState) {

        emptyState.style.display =
          visibleCount === 0 ? 'flex' : 'none';

      }

    };


    /* Search */
    searchInput.addEventListener(
      'input',
      updateResults
    );


    /* Clear search */
    if (clearButton) {

      clearButton.addEventListener(
        'click',
        () => {

          searchInput.value = '';

          updateResults();

          searchInput.focus();

        }
      );

    }


    /* Filter buttons */
    filterButtons.addEventListener(
      'click',
      (event) => {

        const button =
          event.target.closest(
            '.restaurant-filter-button'
          );


        if (!button) {
          return;
        }


        activeFilter =
          button.dataset.filter || 'all';


        filterButtons
          .querySelectorAll(
            '.restaurant-filter-button'
          )
          .forEach((item) => {

            item.classList.toggle(
              'active',
              item === button
            );

          });


        updateResults();

      }
    );


    /* Reset */
    if (resetButton) {

      resetButton.addEventListener(
        'click',
        () => {

          searchInput.value = '';

          activeFilter = 'all';


          filterButtons
            .querySelectorAll(
              '.restaurant-filter-button'
            )
            .forEach((button) => {

              button.classList.toggle(
                'active',
                button.dataset.filter === 'all'
              );

            });


          updateResults();

        }
      );

    }


    updateResults();

  })();

</script>