<% layout('layouts/adminBoilerplate') %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Restaurant Details</h4>
        <a href="/admin/restaurants" class="btn btn-light btn-sm">Back</a>
      </div>
      <div class="card-body">
        <div class="row g-4 align-items-start">
          <div class="col-md-4">
            <img
              src="<%= restaurant.image && restaurant.image.url ? restaurant.image.url : 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png' %>"
              class="img-fluid rounded"
              alt="restaurant"
            />
          </div>
          <div class="col-md-8">
            <h3 class="mb-3"><%= restaurant.username %></h3>
            <p class="mb-1"><strong>Email:</strong> <%= restaurant.email %></p>
            <p class="mb-1"><strong>Location:</strong> <%= restaurant.location %></p>
            <p class="mb-1"><strong>Status:</strong> <%= restaurant.isOpen ? 'Enabled' : 'Disabled' %></p>
            <p class="mb-1"><strong>Member Since:</strong> <%= restaurant.createdAt ? new Date(restaurant.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></p>
            <form action="/admin/restaurants/<%= restaurant._id %>/toggle" method="POST" class="d-inline">
              <button class="btn <%= restaurant.isOpen ? 'btn-warning' : 'btn-success' %>">
                <%= restaurant.isOpen ? 'Disable Restaurant' : 'Enable Restaurant' %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
