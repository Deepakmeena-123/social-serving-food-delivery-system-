<% layout('layouts/adminBoilerplate') %>

<div class="fb-reports-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <section class="fb-reports-header">

        <div class="fb-reports-header-content">

            <div class="fb-reports-kicker">
                <i class="bi bi-bar-chart-line-fill"></i>
                <span>FoodBridge Analytics</span>
            </div>

            <h1>Reports</h1>

            <p>
                Overview of the current FoodBridge platform activity.
            </p>

        </div>

        <div class="fb-reports-header-icon">
            <i class="bi bi-graph-up-arrow"></i>
        </div>

    </section>


    <!-- =====================================================
         PLATFORM OVERVIEW
         ===================================================== -->

    <section class="fb-report-section">

        <div class="fb-report-section-heading">

            <div>

                <h2>
                    Platform Overview
                </h2>

                <p>
                    Current totals available in the admin system.
                </p>

            </div>

            <span class="fb-report-badge">
                <i class="bi bi-activity"></i>
                Overview
            </span>

        </div>


        <div class="fb-report-metrics">


            <!-- RESTAURANTS -->

            <article class="fb-report-metric">

                <div class="fb-report-metric-top">

                    <div class="fb-report-metric-icon restaurants">
                        <i class="bi bi-shop-window"></i>
                    </div>

                    <span class="fb-report-metric-label">
                        Restaurants
                    </span>

                </div>


                <strong class="fb-report-metric-value">
                    <%= totalRestaurants %>
                </strong>


                <p>
                    Registered restaurant partners
                </p>

            </article>



            <!-- NGOS -->

            <article class="fb-report-metric">

                <div class="fb-report-metric-top">

                    <div class="fb-report-metric-icon ngos">
                        <i class="bi bi-building-heart"></i>
                    </div>

                    <span class="fb-report-metric-label">
                        NGOs
                    </span>

                </div>


                <strong class="fb-report-metric-value">
                    <%= totalNGOs %>
                </strong>


                <p>
                    Registered NGO partners
                </p>

            </article>



            <!-- DONATIONS -->

            <article class="fb-report-metric featured">

                <div class="fb-report-metric-top">

                    <div class="fb-report-metric-icon donations">
                        <i class="bi bi-gift-fill"></i>
                    </div>

                    <span class="fb-report-metric-label">
                        Donations
                    </span>

                </div>


                <strong class="fb-report-metric-value">
                    <%= totalDonations %>
                </strong>


                <p>
                    Total donation records
                </p>

            </article>


        </div>

    </section>



    <!-- =====================================================
         DONATION SUMMARY
         ===================================================== -->

    <section class="fb-report-section">

        <div class="fb-report-section-heading">

            <div>

                <h2>
                    Donation Summary
                </h2>

                <p>
                    Current donation activity across the platform.
                </p>

            </div>

        </div>


        <div class="fb-donation-summary-card">


            <div class="fb-donation-summary-icon">

                <i class="bi bi-gift-fill"></i>

            </div>


            <div class="fb-donation-summary-content">

                <span>
                    Total Donation Records
                </span>


                <strong>
                    <%= totalDonations %>
                </strong>


                <p>
                    FoodBridge donation records currently available
                    in the admin system.
                </p>

            </div>


            <div class="fb-donation-summary-status">

                <span></span>

                Tracking Active

            </div>


        </div>

    </section>



    <!-- =====================================================
         INFORMATION
         ===================================================== -->

    <section class="fb-report-information">

        <div class="fb-report-information-icon">

            <i class="bi bi-info-circle-fill"></i>

        </div>


        <div>

            <h3>
                About These Reports
            </h3>


            <p>
                This page displays the platform totals currently
                provided by the FoodBridge admin system. Detailed
                charts and advanced analytics can be added later
                when the required datasets are available.
            </p>

        </div>

    </section>


</div>