<% layout('layouts/adminBoilerplate') %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">NGO Details</h4>
        <a href="/admin/ngos" class="btn btn-light btn-sm">Back</a>
      </div>
      <div class="card-body">
        <div class="row g-4 align-items-start">
          <div class="col-md-4">
            <img
              src="<%= ngo.image && ngo.image.url ? ngo.image.url : 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png' %>"
              class="img-fluid rounded"
              alt="ngo"
            />
          </div>
          <div class="col-md-8">
            <h3 class="mb-3"><%= ngo.username %></h3>
            <p class="mb-1"><strong>Email:</strong> <%= ngo.email %></p>
            <p class="mb-1"><strong>Location:</strong> <%= ngo.location %></p>
            <p class="mb-1"><strong>Contact Number:</strong> <%= ngo.contactNumber || 'Not provided' %></p>
            <p class="mb-1"><strong>Status:</strong> <%= ngo.isOpen ? 'Enabled' : 'Disabled' %></p>
            <p class="mb-1"><strong>Member Since:</strong> <%= ngo.createdAt ? new Date(ngo.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></p>
            <p class="mb-3"><strong>Total Food Distributed:</strong> <%= totalFoodDistributed %></p>
            <form action="/admin/ngos/<%= ngo._id %>/toggle" method="POST" class="d-inline">
              <button class="btn <%= ngo.isOpen ? 'btn-warning' : 'btn-success' %>">
                <%= ngo.isOpen ? 'Disable NGO' : 'Enable NGO' %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
