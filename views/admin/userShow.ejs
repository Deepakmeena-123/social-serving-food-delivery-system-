<% layout('layouts/adminBoilerplate') %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">User Details</h4>
        <a href="/admin/users" class="btn btn-light btn-sm">Back</a>
      </div>
      <div class="card-body">
        <div class="row g-4 align-items-start">
          <div class="col-md-4">
            <img
              src="<%= user.image && user.image.url ? user.image.url : 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png' %>"
              class="img-fluid rounded"
              alt="profile"
            />
          </div>
          <div class="col-md-8">
            <h3 class="mb-3"><%= user.username %></h3>
            <p class="mb-1"><strong>Email:</strong> <%= user.email %></p>
            <p class="mb-1"><strong>Role:</strong> <%= user.roles %></p>
            <p class="mb-1"><strong>Location:</strong> <%= user.location %></p>
            <p class="mb-1"><strong>Contact Number:</strong> <%= user.contactNumber || 'Not provided' %></p>
            <p class="mb-1"><strong>Member Since:</strong> <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></p>
            <p class="mb-3">
              <strong>Status:</strong>
              <% if (user.isOpen) { %>
                <span class="badge bg-success">Enabled</span>
              <% } else { %>
                <span class="badge bg-secondary">Disabled</span>
              <% } %>
            </p>
            <form action="/admin/users/<%= user._id %>/toggle" method="POST" class="d-inline">
              <button class="btn <%= user.isOpen ? 'btn-warning' : 'btn-success' %>">
                <%= user.isOpen ? 'Disable User' : 'Enable User' %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
