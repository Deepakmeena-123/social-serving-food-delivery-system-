<% layout('layouts/adminBoilerplate') %>

<div class="admin-dashboard-clean">

    <!-- =====================================================
         DASHBOARD HEADER
         ===================================================== -->

    <section class="dashboard-clean-header">

        <div>

            <span class="dashboard-clean-kicker">
                <i class="bi bi-grid-1x2-fill"></i>
                FoodBridge Admin
            </span>

            <h1 class="dashboard-clean-title">
                Dashboard
            </h1>

            <p class="dashboard-clean-subtitle">
                Monitor your platform and manage important activities from one place.
            </p>

        </div>

    </section>


    <!-- =====================================================
         PLATFORM OVERVIEW
         ===================================================== -->

    <section class="dashboard-clean-section">

        <div class="dashboard-clean-section-heading">

            <div>

                <h2>
                    Platform Overview
                </h2>

                <p>
                    Current FoodBridge statistics.
                </p>

            </div>

        </div>


        <div class="dashboard-stat-grid">


            <!-- USERS -->

            <a
                href="/admin/users"
                class="dashboard-stat-card dashboard-stat-users"
            >

                <div class="dashboard-stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div class="dashboard-stat-content">

                    <span>
                        Total Users
                    </span>

                    <strong>
                        <%= totalUsers %>
                    </strong>

                </div>

                <i class="bi bi-arrow-up-right dashboard-stat-arrow"></i>

            </a>


            <!-- RESTAURANTS -->

            <a
                href="/admin/restaurants"
                class="dashboard-stat-card dashboard-stat-restaurants"
            >

                <div class="dashboard-stat-icon">
                    <i class="bi bi-shop-window"></i>
                </div>

                <div class="dashboard-stat-content">

                    <span>
                        Restaurants
                    </span>

                    <strong>
                        <%= totalRestaurants %>
                    </strong>

                </div>

                <i class="bi bi-arrow-up-right dashboard-stat-arrow"></i>

            </a>


            <!-- NGOs -->

            <a
                href="/admin/ngos"
                class="dashboard-stat-card dashboard-stat-ngos"
            >

                <div class="dashboard-stat-icon">
                    <i class="bi bi-building-heart"></i>
                </div>

                <div class="dashboard-stat-content">

                    <span>
                        NGOs
                    </span>

                    <strong>
                        <%= totalNGOs %>
                    </strong>

                </div>

                <i class="bi bi-arrow-up-right dashboard-stat-arrow"></i>

            </a>


            <!-- DONATIONS -->

            <a
                href="/admin/donations"
                class="dashboard-stat-card dashboard-stat-donations"
            >

                <div class="dashboard-stat-icon">
                    <i class="bi bi-gift-fill"></i>
                </div>

                <div class="dashboard-stat-content">

                    <span>
                        Total Donations
                    </span>

                    <strong>
                        <%= totalDonations %>
                    </strong>

                </div>

                <i class="bi bi-arrow-up-right dashboard-stat-arrow"></i>

            </a>


        </div>

    </section>


    <!-- =====================================================
         PENDING DONATIONS
         ===================================================== -->

    <section class="dashboard-clean-section">

        <div class="dashboard-attention-card">


            <div class="dashboard-attention-icon">

                <i class="bi bi-hourglass-split"></i>

            </div>


            <div class="dashboard-attention-content">

                <span class="dashboard-attention-label">
                    Needs Attention
                </span>


                <h2>

                    <%= pendingDonations %>

                    pending donation<%= pendingDonations === 1 ? '' : 's' %>

                </h2>


                <p>
                    Review pending donations and update their status when required.
                </p>

            </div>


            <a
                href="/admin/donations"
                class="dashboard-attention-button"
            >

                Review Donations

                <i class="bi bi-arrow-right"></i>

            </a>


        </div>

    </section>


    <!-- =====================================================
         MANAGEMENT
         ===================================================== -->

    <section class="dashboard-clean-section">

        <div class="dashboard-clean-section-heading">

            <div>

                <h2>
                    Management
                </h2>

                <p>
                    Quickly open the section you want to manage.
                </p>

            </div>

        </div>


        <div class="dashboard-shortcuts">


            <!-- USERS -->

            <a
                href="/admin/users"
                class="dashboard-shortcut"
            >

                <i class="bi bi-people"></i>

                <span>
                    Users
                </span>

                <i class="bi bi-chevron-right"></i>

            </a>


            <!-- RESTAURANTS -->

            <a
                href="/admin/restaurants"
                class="dashboard-shortcut"
            >

                <i class="bi bi-shop"></i>

                <span>
                    Restaurants
                </span>

                <i class="bi bi-chevron-right"></i>

            </a>


            <!-- NGOs -->

            <a
                href="/admin/ngos"
                class="dashboard-shortcut"
            >

                <i class="bi bi-building"></i>

                <span>
                    NGOs
                </span>

                <i class="bi bi-chevron-right"></i>

            </a>


            <!-- DONATIONS -->

            <a
                href="/admin/donations"
                class="dashboard-shortcut"
            >

                <i class="bi bi-gift"></i>

                <span>
                    Donations
                </span>

                <i class="bi bi-chevron-right"></i>

            </a>


            <!-- REPORTS -->

            <a
                href="/admin/reports"
                class="dashboard-shortcut"
            >

                <i class="bi bi-bar-chart-line"></i>

                <span>
                    Reports
                </span>

                <i class="bi bi-chevron-right"></i>

            </a>


        </div>

    </section>

</div>