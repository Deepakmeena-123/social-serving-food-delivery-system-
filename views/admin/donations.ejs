<% layout('layouts/adminBoilerplate') %>
<%
  const donationCount = Array.isArray(donations) ? donations.length : 0;
  const statusCount = (status) => (Array.isArray(donations) ? donations.filter(donation => donation.status === status).length : 0);
  const totalDonationsCount = donationCount;
  const pendingDonationsCount = statusCount('Pending');
  const acceptedDonationsCount = statusCount('Accepted');
  const completedDonationsCount = statusCount('Completed');
%>

<div class="admin-donations-page">
  <section class="donations-hero card admin-glass-card mb-4">
    <div class="card-body p-4 p-lg-5">
      <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-4">
        <div>
          <div class="donations-hero-kicker mb-2">
            <i class="bi bi-gift-fill"></i>
            <span>FoodBridge Donation Center</span>
          </div>
          <h1 class="donations-page-title mb-2">Donations Management</h1>
          <p class="donations-page-subtitle mb-0">Monitor and manage all food donations across the platform.</p>
        </div>
        <a href="/admin" class="btn admin-outline-btn">
          <i class="bi bi-arrow-left me-2"></i>
          Back to Dashboard
        </a>
      </div>
    </div>
  </section>

  <section class="mb-4">
    <div class="row g-3 g-xl-4">
      <div class="col-6 col-xl-3">
        <article class="stat-card stat-card-donations">
          <div class="stat-card-icon"><i class="bi bi-gift-fill"></i></div>
          <div class="stat-card-body">
            <span class="stat-card-label">Total Donations</span>
            <strong class="stat-card-value"><%= totalDonationsCount %></strong>
          </div>
        </article>
      </div>
      <div class="col-6 col-xl-3">
        <article class="stat-card stat-card-pending">
          <div class="stat-card-icon"><i class="bi bi-hourglass-split"></i></div>
          <div class="stat-card-body">
            <span class="stat-card-label">Pending Donations</span>
            <strong class="stat-card-value"><%= pendingDonationsCount %></strong>
          </div>
        </article>
      </div>
      <div class="col-6 col-xl-3">
        <article class="stat-card stat-card-restaurants">
          <div class="stat-card-icon"><i class="bi bi-check2-circle"></i></div>
          <div class="stat-card-body">
            <span class="stat-card-label">Accepted Donations</span>
            <strong class="stat-card-value"><%= acceptedDonationsCount %></strong>
          </div>
        </article>
      </div>
      <div class="col-6 col-xl-3">
        <article class="stat-card stat-card-ngos">
          <div class="stat-card-icon"><i class="bi bi-clipboard-check-fill"></i></div>
          <div class="stat-card-body">
            <span class="stat-card-label">Completed Donations</span>
            <strong class="stat-card-value"><%= completedDonationsCount %></strong>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="card donations-toolbar-card mb-4 admin-glass-card">
    <div class="card-body p-3 p-lg-4">
      <div class="row g-3 align-items-center">
        <div class="col-xl-6">
          <label for="donationsSearchInput" class="form-label donations-toolbar-label mb-2">Search donations</label>
          <div class="row g-2">
            <div class="col-md-4">
              <div class="input-group donations-search-group">
                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                <input type="text" id="donationsSearchInput" class="form-control" placeholder="Donor name">
              </div>
            </div>
            <div class="col-md-4">
              <div class="input-group donations-search-group">
                <span class="input-group-text"><i class="bi bi-building-heart"></i></span>
                <input type="text" id="donationsNgoSearchInput" class="form-control" placeholder="NGO name">
              </div>
            </div>
            <div class="col-md-4">
              <div class="input-group donations-search-group">
                <span class="input-group-text"><i class="bi bi-basket"></i></span>
                <input type="text" id="donationsFoodSearchInput" class="form-control" placeholder="Food item">
              </div>
            </div>
          </div>
        </div>
        <div class="col-xl-6">
          <div class="donations-filter-header mb-2">Filter by status</div>
          <div class="donations-filter-group" id="donationsFilterGroup">
            <button type="button" class="donations-filter-btn active" data-filter="all">All</button>
            <button type="button" class="donations-filter-btn" data-filter="Pending">Pending</button>
            <button type="button" class="donations-filter-btn" data-filter="Accepted">Accepted</button>
            <button type="button" class="donations-filter-btn" data-filter="Completed">Completed</button>
            <button type="button" class="donations-filter-btn" data-filter="Rejected">Rejected</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="donations-table-card card admin-glass-card">
    <div class="card-body p-0">
      <div class="donations-table-header px-4 py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
          <h2 class="donations-table-title mb-1">Donation Records</h2>
          <p class="donations-table-subtitle mb-0"><%= donationCount %> donation entries available for review.</p>
        </div>
        <div class="donations-table-legend d-flex flex-wrap gap-2">
          <span class="legend-pill legend-pill-yellow"><i class="bi bi-dot"></i> Pending</span>
          <span class="legend-pill legend-pill-blue"><i class="bi bi-dot"></i> Accepted</span>
          <span class="legend-pill legend-pill-green"><i class="bi bi-dot"></i> Completed</span>
          <span class="legend-pill legend-pill-red"><i class="bi bi-dot"></i> Rejected</span>
        </div>
      </div>

      <% if (donations && donations.length) { %>
        <div class="table-responsive donations-table-responsive">
          <table class="table align-middle mb-0 donations-table">
            <thead>
              <tr>
                <th>Donor Name</th>
                <th>Donor Type</th>
                <th>NGO Name</th>
                <th>Food Items</th>
                <th>Quantity</th>
                <th>Status</th>
                <th>Donation Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="donationsTableBody">
              <% donations.forEach(donation => { %>
                <tr
                  class="donations-row"
                  data-status="<%= donation.status || 'Pending' %>"
                  data-search="<%= `${donation.donorName || (donation.donorId && donation.donorId.username) || ''} ${donation.ngoName || (donation.ngoId && donation.ngoId.username) || ''} ${donation.foodName || (donation.foodId && donation.foodId.name) || ''}`.toLowerCase() %>"
                >
                  <td>
                    <div class="donation-person-cell">
                      <div class="donation-avatar"><i class="bi bi-person-fill"></i></div>
                      <span><%= donation.donorName || (donation.donorId && donation.donorId.username) || 'N/A' %></span>
                    </div>
                  </td>
                  <td>
                    <span class="donor-type-badge <%= (donation.donorType || '').toLowerCase() === 'restaurant' ? 'donor-type-restaurant' : 'donor-type-customer' %>">
                      <%= donation.donorType || 'N/A' %>
                    </span>
                  </td>
                  <td><%= donation.ngoName || (donation.ngoId && donation.ngoId.username) || 'N/A' %></td>
                  <td><%= donation.foodName || (donation.foodId && donation.foodId.name) || 'N/A' %></td>
                  <td><span class="donation-quantity"><%= donation.donatedQuantity %></span></td>
                  <td>
                    <% if (donation.status === 'Accepted') { %>
                      <span class="donation-status-badge donation-status-accepted"><i class="bi bi-check2-circle me-1"></i>Accepted</span>
                    <% } else if (donation.status === 'Completed') { %>
                      <span class="donation-status-badge donation-status-completed"><i class="bi bi-check-circle-fill me-1"></i>Completed</span>
                    <% } else if (donation.status === 'Rejected') { %>
                      <span class="donation-status-badge donation-status-rejected"><i class="bi bi-x-circle-fill me-1"></i>Rejected</span>
                    <% } else { %>
                      <span class="donation-status-badge donation-status-pending"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="donation-date-cell">
                      <i class="bi bi-calendar3"></i>
                      <span><%= donation.donationDate ? new Date(donation.donationDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A' %></span>
                    </div>
                  </td>
                  <td>
                    <div class="donations-actions">
                      <button type="button" class="btn btn-sm donation-action-btn donation-action-view" disabled title="View details UI only">
                        <i class="bi bi-eye"></i>
                        <span>View Details</span>
                      </button>
                      <button type="button" class="btn btn-sm donation-action-btn donation-action-approve" disabled title="Approve UI only">
                        <i class="bi bi-check2-circle"></i>
                        <span>Approve</span>
                      </button>
                      <button type="button" class="btn btn-sm donation-action-btn donation-action-reject" disabled title="Reject UI only">
                        <i class="bi bi-x-circle"></i>
                        <span>Reject</span>
                      </button>
                      <button type="button" class="btn btn-sm donation-action-btn donation-action-delete" disabled title="Delete UI only">
                        <i class="bi bi-trash3"></i>
                        <span>Delete</span>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div id="donationsEmptyState" class="donations-empty-state d-none">
          <div class="donations-empty-icon"><i class="bi bi-gift"></i></div>
          <h3>No matching donations found</h3>
          <p>Try a different donor name, NGO name, food item, or switch back to All.</p>
        </div>
      <% } else { %>
        <div class="donations-empty-state">
          <div class="donations-empty-icon"><i class="bi bi-gift"></i></div>
          <h3>No donations available</h3>
          <p>Donation records will appear here once users start submitting them.</p>
        </div>
      <% } %>
    </div>
  </section>
</div>

<script>
  (function () {
    const donorInput = document.getElementById('donationsSearchInput');
    const ngoInput = document.getElementById('donationsNgoSearchInput');
    const foodInput = document.getElementById('donationsFoodSearchInput');
    const filterGroup = document.getElementById('donationsFilterGroup');
    const rows = Array.from(document.querySelectorAll('.donations-row'));
    const emptyState = document.getElementById('donationsEmptyState');

    if (!filterGroup || !rows.length || !donorInput || !ngoInput || !foodInput) return;

    let activeFilter = 'all';

    const normalize = (value) => (value || '').trim().toLowerCase();

    const updateEmptyState = (visibleCount) => {
      if (!emptyState) return;
      emptyState.classList.toggle('d-none', visibleCount !== 0);
    };

    const applyFilters = () => {
      const donorQuery = normalize(donorInput.value);
      const ngoQuery = normalize(ngoInput.value);
      const foodQuery = normalize(foodInput.value);
      let visibleCount = 0;

      rows.forEach((row) => {
        const status = row.dataset.status || '';
        const searchable = row.dataset.search || '';
        const matchesStatus = activeFilter === 'all' || status === activeFilter;
        const matchesSearch =
          (!donorQuery || searchable.includes(donorQuery)) &&
          (!ngoQuery || searchable.includes(ngoQuery)) &&
          (!foodQuery || searchable.includes(foodQuery));
        const shouldShow = matchesStatus && matchesSearch;

        row.classList.toggle('d-none', !shouldShow);
        if (shouldShow) visibleCount += 1;
      });

      updateEmptyState(visibleCount);
    };

    filterGroup.addEventListener('click', (event) => {
      const button = event.target.closest('.donations-filter-btn');
      if (!button) return;

      activeFilter = button.dataset.filter || 'all';

      filterGroup.querySelectorAll('.donations-filter-btn').forEach((item) => {
        item.classList.toggle('active', item === button);
      });

      applyFilters();
    });

    [donorInput, ngoInput, foodInput].forEach((input) => input.addEventListener('input', applyFilters));

    applyFilters();
  })();
</script>
