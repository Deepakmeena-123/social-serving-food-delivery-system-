<% layout('layouts/adminBoilerplate') %>

<%
  /*
   * =========================================================
   * DONATION DATA
   * =========================================================
   */

  const donationsList = Array.isArray(donations)
    ? donations
    : [];


  /*
   * =========================================================
   * COUNTS
   * =========================================================
   */

  const totalDonations = donationsList.length;


  const pendingDonations = donationsList.filter(function (donation) {
    return donation.status === 'Pending';
  }).length;


  const acceptedDonations = donationsList.filter(function (donation) {
    return donation.status === 'Accepted';
  }).length;


  const completedDonations = donationsList.filter(function (donation) {
    return donation.status === 'Completed';
  }).length;


  const rejectedDonations = donationsList.filter(function (donation) {
    return donation.status === 'Rejected';
  }).length;


  /*
   * =========================================================
   * HELPER FUNCTIONS
   * =========================================================
   */

  function getDonorName(donation) {

    if (!donation) {
      return 'N/A';
    }

    if (donation.donorName) {
      return donation.donorName;
    }

    if (
      donation.donorId &&
      donation.donorId.username
    ) {
      return donation.donorId.username;
    }

    return 'N/A';
  }


  function getNgoName(donation) {

    if (!donation) {
      return 'N/A';
    }

    if (donation.ngoName) {
      return donation.ngoName;
    }

    if (
      donation.ngoId &&
      donation.ngoId.username
    ) {
      return donation.ngoId.username;
    }

    return 'N/A';
  }


  function getFoodName(donation) {

    if (!donation) {
      return 'N/A';
    }

    if (donation.foodName) {
      return donation.foodName;
    }

    if (
      donation.foodId &&
      donation.foodId.name
    ) {
      return donation.foodId.name;
    }

    return 'N/A';
  }


  function getSearchText(donation) {

    return [
      getDonorName(donation),
      donation.donorType || '',
      getNgoName(donation),
      getFoodName(donation)
    ]
      .join(' ')
      .toLowerCase();
  }

%>


<div class="admin-donations-clean">


  <!-- =====================================================
       PAGE HEADER
       ===================================================== -->

  <section class="donations-clean-header">

    <div>

      <div class="donations-clean-kicker">

        <i class="bi bi-gift-fill"></i>

        <span>
          Donation Management
        </span>

      </div>


      <h1>
        Donations
      </h1>


      <p>
        Monitor food donations and track their current status.
      </p>

    </div>

  </section>



  <!-- =====================================================
       SUMMARY CARDS
       ===================================================== -->

  <section class="donations-summary-grid">


    <!-- TOTAL -->

    <div class="donations-summary-card">

      <div class="donations-summary-icon">

        <i class="bi bi-gift"></i>

      </div>


      <div>

        <span>
          Total Donations
        </span>


        <strong>
          <%= totalDonations %>
        </strong>

      </div>

    </div>



    <!-- PENDING -->

    <div class="donations-summary-card donations-summary-pending">

      <div class="donations-summary-icon">

        <i class="bi bi-hourglass-split"></i>

      </div>


      <div>

        <span>
          Pending
        </span>


        <strong>
          <%= pendingDonations %>
        </strong>

      </div>

    </div>



    <!-- ACCEPTED -->

    <div class="donations-summary-card donations-summary-accepted">

      <div class="donations-summary-icon">

        <i class="bi bi-check2-circle"></i>

      </div>


      <div>

        <span>
          Accepted
        </span>


        <strong>
          <%= acceptedDonations %>
        </strong>

      </div>

    </div>



    <!-- COMPLETED -->

    <div class="donations-summary-card donations-summary-completed">

      <div class="donations-summary-icon">

        <i class="bi bi-check-circle-fill"></i>

      </div>


      <div>

        <span>
          Completed
        </span>


        <strong>
          <%= completedDonations %>
        </strong>

      </div>

    </div>


  </section>



  <!-- =====================================================
       SEARCH + FILTER
       ===================================================== -->

  <section class="donations-management-controls">


    <!-- SEARCH -->

    <div class="donations-search-wrapper">

      <label for="donationsSearchInput">
        Search Donations
      </label>


      <div class="donations-search-box">

        <i class="bi bi-search"></i>


        <input
          type="text"
          id="donationsSearchInput"
          placeholder="Search donor, NGO, food item or donor type..."
          autocomplete="off"
        />


        <button
          type="button"
          id="donationsClearSearch"
          class="donations-clear-search"
        >
          Clear
        </button>

      </div>

    </div>



    <!-- STATUS FILTER -->

    <div class="donations-filter-wrapper">

      <span>
        Filter by Status
      </span>


      <div
        class="donations-filter-buttons"
        id="donationsFilterGroup"
      >


        <!-- ALL -->

        <button
          type="button"
          class="donations-filter-button active"
          data-filter="all"
        >

          All

          <span>
            <%= totalDonations %>
          </span>

        </button>



        <!-- PENDING -->

        <button
          type="button"
          class="donations-filter-button"
          data-filter="Pending"
        >

          Pending

          <span>
            <%= pendingDonations %>
          </span>

        </button>



        <!-- ACCEPTED -->

        <button
          type="button"
          class="donations-filter-button"
          data-filter="Accepted"
        >

          Accepted

          <span>
            <%= acceptedDonations %>
          </span>

        </button>



        <!-- COMPLETED -->

        <button
          type="button"
          class="donations-filter-button"
          data-filter="Completed"
        >

          Completed

          <span>
            <%= completedDonations %>
          </span>

        </button>



        <!-- REJECTED -->

        <button
          type="button"
          class="donations-filter-button"
          data-filter="Rejected"
        >

          Rejected

          <span>
            <%= rejectedDonations %>
          </span>

        </button>


      </div>

    </div>


  </section>



  <!-- =====================================================
       DONATION LIST
       ===================================================== -->

  <section class="donations-list-card">


    <!-- LIST HEADER -->

    <div class="donations-list-header">

      <div>

        <h2>
          Donation Records
        </h2>


        <p>
          Review food donation records across FoodBridge.
        </p>

      </div>


      <div class="donations-result-count">

        <i class="bi bi-gift"></i>


        <span id="donationsResultCount">
          <%= totalDonations %>
        </span>


        <span>
          donations
        </span>

      </div>

    </div>



    <!-- =====================================================
         DATA AVAILABLE
         ===================================================== -->

    <% if (donationsList.length > 0) { %>


      <div class="donations-table-wrapper">


        <table class="donations-management-table">


          <thead>

            <tr>

              <th>
                Donor
              </th>

              <th>
                Type
              </th>

              <th>
                NGO
              </th>

              <th>
                Food Item
              </th>

              <th>
                Quantity
              </th>

              <th>
                Status
              </th>

              <th>
                Donation Date
              </th>

            </tr>

          </thead>



          <tbody id="donationsTableBody">


            <% donationsList.forEach(function (donation) { %>


              <tr
                class="donations-management-row"
                data-status="<%= donation.status || 'Pending' %>"
                data-search="<%= getSearchText(donation) %>"
              >


                <!-- =====================================
                     DONOR
                     ===================================== -->

                <td>

                  <div class="donation-donor-cell">


                    <div class="donation-donor-avatar">

                      <i class="bi bi-person-fill"></i>

                    </div>


                    <div class="donation-donor-info">

                      <strong>
                        <%= getDonorName(donation) %>
                      </strong>


                      <span>
                        Donor
                      </span>

                    </div>


                  </div>

                </td>



                <!-- =====================================
                     DONOR TYPE
                     ===================================== -->

                <td>


                  <%
                    const donorType =
                      donation.donorType ||
                      'Customer';
                  %>


                  <% if (
                    donorType.toLowerCase() === 'restaurant'
                  ) { %>


                    <span class="donation-type restaurant">

                      <i class="bi bi-shop"></i>

                      Restaurant

                    </span>


                  <% } else { %>


                    <span class="donation-type customer">

                      <i class="bi bi-person"></i>

                      <%= donorType %>

                    </span>


                  <% } %>


                </td>



                <!-- =====================================
                     NGO
                     ===================================== -->

                <td>

                  <div class="donation-ngo-cell">

                    <i class="bi bi-building-heart"></i>


                    <span>
                      <%= getNgoName(donation) %>
                    </span>

                  </div>

                </td>



                <!-- =====================================
                     FOOD
                     ===================================== -->

                <td>

                  <div class="donation-food-cell">

                    <i class="bi bi-basket2"></i>


                    <span>
                      <%= getFoodName(donation) %>
                    </span>

                  </div>

                </td>



                <!-- =====================================
                     QUANTITY
                     ===================================== -->

                <td>

                  <span class="donation-quantity-value">

                    <%= donation.donatedQuantity || 0 %>

                  </span>

                </td>



                <!-- =====================================
                     STATUS
                     ===================================== -->

                <td>


                  <% if (
                    donation.status === 'Accepted'
                  ) { %>


                    <span class="donation-clean-status accepted">

                      <span class="donation-status-dot"></span>

                      Accepted

                    </span>


                  <% } else if (
                    donation.status === 'Completed'
                  ) { %>


                    <span class="donation-clean-status completed">

                      <span class="donation-status-dot"></span>

                      Completed

                    </span>


                  <% } else if (
                    donation.status === 'Rejected'
                  ) { %>


                    <span class="donation-clean-status rejected">

                      <span class="donation-status-dot"></span>

                      Rejected

                    </span>


                  <% } else { %>


                    <span class="donation-clean-status pending">

                      <span class="donation-status-dot"></span>

                      Pending

                    </span>


                  <% } %>


                </td>



                <!-- =====================================
                     DATE
                     ===================================== -->

                <td>

                  <span class="donation-date-value">

                    <i class="bi bi-calendar3"></i>


                    <%= donation.donationDate
                      ? new Date(
                          donation.donationDate
                        ).toLocaleDateString(
                          'en-IN',
                          {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric'
                          }
                        )
                      : 'N/A'
                    %>


                  </span>

                </td>


              </tr>


            <% }) %>


          </tbody>


        </table>


      </div>



      <!-- =================================================
           NO SEARCH RESULT
           ================================================= -->

      <div
        id="donationsEmptyState"
        class="donations-empty-state"
        style="display: none;"
      >


        <div class="donations-empty-icon">

          <i class="bi bi-search"></i>

        </div>


        <h3>
          No donations found
        </h3>


        <p>
          Try another search term or change the status filter.
        </p>


        <button
          type="button"
          id="donationsResetFilters"
          class="donations-reset-button"
        >
          Reset Filters
        </button>


      </div>


    <% } else { %>


      <!-- =================================================
           NO DONATION DATA
           ================================================= -->

      <div class="donations-empty-state">


        <div class="donations-empty-icon">

          <i class="bi bi-gift"></i>

        </div>


        <h3>
          No donations available
        </h3>


        <p>
          Donation records will appear here once donations are submitted.
        </p>


      </div>


    <% } %>


  </section>


</div>



<!-- =======================================================
     SEARCH + FILTER JAVASCRIPT
     ======================================================= -->

<script>

(function () {

  'use strict';


  /*
   * =====================================================
   * ELEMENTS
   * =====================================================
   */

  const searchInput =
    document.getElementById(
      'donationsSearchInput'
    );


  const clearButton =
    document.getElementById(
      'donationsClearSearch'
    );


  const filterGroup =
    document.getElementById(
      'donationsFilterGroup'
    );


  const rows =
    Array.from(
      document.querySelectorAll(
        '.donations-management-row'
      )
    );


  const emptyState =
    document.getElementById(
      'donationsEmptyState'
    );


  const resultCount =
    document.getElementById(
      'donationsResultCount'
    );


  const resetButton =
    document.getElementById(
      'donationsResetFilters'
    );



  /*
   * =====================================================
   * SAFETY CHECK
   * =====================================================
   */

  if (
    !searchInput ||
    !filterGroup
  ) {

    return;

  }



  /*
   * =====================================================
   * ACTIVE FILTER
   * =====================================================
   */

  let activeFilter = 'all';



  /*
   * =====================================================
   * NORMALIZE TEXT
   * =====================================================
   */

  function normalize(value) {

    return (
      value || ''
    )
      .trim()
      .toLowerCase();

  }



  /*
   * =====================================================
   * APPLY SEARCH + FILTER
   * =====================================================
   */

  function applyFilters() {


    const query =
      normalize(
        searchInput.value
      );


    let visibleCount = 0;



    rows.forEach(function (row) {


      const status =
        row.dataset.status ||
        'Pending';


      const searchable =
        normalize(
          row.dataset.search
        );


      const matchesSearch =
        !query ||
        searchable.includes(
          query
        );


      const matchesFilter =
        activeFilter === 'all' ||
        status === activeFilter;


      const shouldShow =
        matchesSearch &&
        matchesFilter;


      row.style.display =
        shouldShow
          ? ''
          : 'none';


      if (shouldShow) {

        visibleCount++;

      }

    });



    /*
     * Update visible result count
     */

    if (resultCount) {

      resultCount.textContent =
        visibleCount;

    }



    /*
     * Show empty state
     */

    if (emptyState) {

      emptyState.style.display =
        visibleCount === 0
          ? 'flex'
          : 'none';

    }

  }



  /*
   * =====================================================
   * SEARCH EVENT
   * =====================================================
   */

  searchInput.addEventListener(
    'input',
    applyFilters
  );



  /*
   * =====================================================
   * CLEAR SEARCH
   * =====================================================
   */

  if (clearButton) {

    clearButton.addEventListener(
      'click',
      function () {

        searchInput.value = '';

        applyFilters();

        searchInput.focus();

      }
    );

  }



  /*
   * =====================================================
   * FILTER BUTTONS
   * =====================================================
   */

  filterGroup.addEventListener(
    'click',
    function (event) {


      const button =
        event.target.closest(
          '.donations-filter-button'
        );


      if (!button) {

        return;

      }


      activeFilter =
        button.dataset.filter ||
        'all';



      /*
       * Active button
       */

      filterGroup
        .querySelectorAll(
          '.donations-filter-button'
        )
        .forEach(function (item) {

          item.classList.toggle(
            'active',
            item === button
          );

        });



      applyFilters();

    }
  );



  /*
   * =====================================================
   * RESET FILTERS
   * =====================================================
   */

  if (resetButton) {

    resetButton.addEventListener(
      'click',
      function () {


        searchInput.value = '';

        activeFilter = 'all';



        filterGroup
          .querySelectorAll(
            '.donations-filter-button'
          )
          .forEach(function (button) {

            button.classList.toggle(
              'active',
              button.dataset.filter === 'all'
            );

          });



        applyFilters();

      }
    );

  }



  /*
   * =====================================================
   * INITIAL LOAD
   * =====================================================
   */

  applyFilters();


})();

</script>