<% layout('layouts/adminBoilerplate') %>

<%
  /*
   * =========================================================
   * ADMIN PROFILE
   * UI ONLY
   * =========================================================
   */

  const defaultProfileImage =
    'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png';


  const profileImage =
    admin &&
    admin.image &&
    admin.image.url
      ? admin.image.url
      : defaultProfileImage;


  const adminName =
    admin && admin.username
      ? admin.username
      : 'Admin';


  const adminEmail =
    admin && admin.email
      ? admin.email
      : 'Not provided';


  const adminRole =
    admin && admin.roles
      ? admin.roles
      : 'Admin';


  const adminLocation =
    admin && admin.location
      ? admin.location
      : 'Not provided';


  const adminContact =
    admin && admin.contactNumber
      ? admin.contactNumber
      : 'Not provided';


  const createdAt =
    admin && admin.createdAt
      ? new Date(
          admin.createdAt
        ).toLocaleDateString(
          'en-IN',
          {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          }
        )
      : 'Not available';


  const adminInitials =
    adminName
      .split(' ')
      .filter(Boolean)
      .slice(0, 2)
      .map(function (part) {
        return part.charAt(0);
      })
      .join('')
      .toUpperCase() || 'A';

%>


<div class="fb-profile-page">


  <!-- =====================================================
       PROFILE HEADER
       ===================================================== -->

  <section class="fb-profile-header">


    <div class="fb-profile-header-left">


      <div class="fb-profile-kicker">

        <i class="bi bi-person-badge-fill"></i>

        <span>
          Admin Profile
        </span>

      </div>


      <h1>
        My Profile
      </h1>


      <p>
        Manage and review the account information used for your FoodBridge admin access.
      </p>


    </div>


    <div class="fb-profile-header-status">

      <span></span>

      Active Account

    </div>


  </section>



  <!-- =====================================================
       PROFILE MAIN
       ===================================================== -->

  <section class="fb-profile-layout">


    <!-- =================================================
         PROFILE CARD
         ================================================= -->

    <article class="fb-profile-card">


      <div class="fb-profile-cover"></div>


      <div class="fb-profile-card-body">


        <!-- AVATAR -->

        <div class="fb-profile-avatar-area">


          <div class="fb-profile-avatar">

            <img
              src="<%= profileImage %>"
              alt="<%= adminName %>"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />


            <span style="display:none;">
              <%= adminInitials %>
            </span>

          </div>


          <div class="fb-profile-basic">


            <h2>
              <%= adminName %>
            </h2>


            <span class="fb-profile-role">

              <i class="bi bi-shield-lock-fill"></i>

              <%= adminRole %>

            </span>


          </div>


        </div>



        <!-- EMAIL -->

        <div class="fb-profile-email">

          <i class="bi bi-envelope-fill"></i>

          <span>
            <%= adminEmail %>
          </span>

        </div>


      </div>


    </article>



    <!-- =================================================
         ACCOUNT INFORMATION
         ================================================= -->

    <article class="fb-account-card">


      <div class="fb-account-card-header">


        <div>

          <h2>
            Account Information
          </h2>


          <p>
            Details stored for your administrator account.
          </p>

        </div>


        <div class="fb-account-card-icon">

          <i class="bi bi-person-vcard-fill"></i>

        </div>


      </div>



      <div class="fb-account-details">


        <!-- USERNAME -->

        <div class="fb-account-detail">


          <div class="fb-account-detail-icon">

            <i class="bi bi-person"></i>

          </div>


          <div class="fb-account-detail-content">

            <span>
              Username
            </span>


            <strong>
              <%= adminName %>
            </strong>

          </div>


        </div>



        <!-- EMAIL -->

        <div class="fb-account-detail">


          <div class="fb-account-detail-icon">

            <i class="bi bi-envelope"></i>

          </div>


          <div class="fb-account-detail-content">

            <span>
              Email Address
            </span>


            <strong>
              <%= adminEmail %>
            </strong>

          </div>


        </div>



        <!-- ROLE -->

        <div class="fb-account-detail">


          <div class="fb-account-detail-icon">

            <i class="bi bi-shield-check"></i>

          </div>


          <div class="fb-account-detail-content">

            <span>
              Account Role
            </span>


            <strong>
              <%= adminRole %>
            </strong>

          </div>


        </div>



        <!-- LOCATION -->

        <div class="fb-account-detail">


          <div class="fb-account-detail-icon">

            <i class="bi bi-geo-alt"></i>

          </div>


          <div class="fb-account-detail-content">

            <span>
              Location
            </span>


            <strong>
              <%= adminLocation %>
            </strong>

          </div>


        </div>



        <!-- CONTACT -->

        <div class="fb-account-detail">


          <div class="fb-account-detail-icon">

            <i class="bi bi-telephone"></i>

          </div>


          <div class="fb-account-detail-content">

            <span>
              Contact Number
            </span>


            <strong>
              <%= adminContact %>
            </strong>

          </div>


        </div>



        <!-- CREATED -->

        <div class="fb-account-detail">


          <div class="fb-account-detail-icon">

            <i class="bi bi-calendar3"></i>

          </div>


          <div class="fb-account-detail-content">

            <span>
              Account Created
            </span>


            <strong>
              <%= createdAt %>
            </strong>

          </div>


        </div>


      </div>


    </article>


  </section>



  <!-- =====================================================
       SECURITY INFORMATION
       ===================================================== -->

  <section class="fb-profile-security">


    <div class="fb-profile-security-icon">

      <i class="bi bi-shield-lock-fill"></i>

    </div>


    <div>

      <h3>
        Account Security
      </h3>


      <p>
        Your administrator account controls access to FoodBridge's
        management area. Keep your login credentials secure and
        avoid sharing your password with others.
      </p>

    </div>


  </section>


</div>