<% layout('layouts/adminBoilerplate') %>

<%
  const ngosList = Array.isArray(ngos) ? ngos : [];

  const totalNGOs = ngosList.length;

  const activeNGOs = ngosList.filter(
    (ngo) => ngo.isOpen
  ).length;

  const inactiveNGOs =
    totalNGOs - activeNGOs;

  const defaultNgoImage =
    'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png';


  const getNgoImage = (ngo) => {

    if (
      ngo &&
      ngo.image &&
      ngo.image.url
    ) {
      return ngo.image.url;
    }

    return defaultNgoImage;
  };


  const getNgoName = (ngo) => {

    if (!ngo) {
      return 'Unnamed NGO';
    }

    return (
      ngo.username ||
      'Unnamed NGO'
    );
  };


  const getSearchText = (ngo) => {

    if (!ngo) {
      return '';
    }

    return [
      ngo.username,
      ngo.email,
      ngo.location,
      ngo.contactNumber
    ]
      .filter(Boolean)
      .join(' ')
      .toLowerCase();
  };
%>


<div class="ngo-management-page">


  <!-- =====================================================
       PAGE HEADER
       ===================================================== -->

  <section class="ngo-management-header">

    <div>

      <div class="ngo-management-kicker">

        <i class="bi bi-building-heart"></i>

        <span>NGO Management</span>

      </div>


      <h1>
        NGOs
      </h1>


      <p>
        Manage registered NGOs and control their account availability.
      </p>

    </div>

  </section>



  <!-- =====================================================
       SUMMARY
       ===================================================== -->

  <section class="ngo-summary-grid">


    <!-- TOTAL -->

    <div class="ngo-summary-card">

      <div class="ngo-summary-icon">

        <i class="bi bi-building-heart"></i>

      </div>


      <div>

        <span>
          Total NGOs
        </span>

        <strong>
          <%= totalNGOs %>
        </strong>

      </div>

    </div>



    <!-- ACTIVE -->

    <div class="ngo-summary-card ngo-summary-active">

      <div class="ngo-summary-icon">

        <i class="bi bi-check-circle"></i>

      </div>


      <div>

        <span>
          Active
        </span>

        <strong>
          <%= activeNGOs %>
        </strong>

      </div>

    </div>



    <!-- INACTIVE -->

    <div class="ngo-summary-card ngo-summary-inactive">

      <div class="ngo-summary-icon">

        <i class="bi bi-dash-circle"></i>

      </div>


      <div>

        <span>
          Inactive
        </span>

        <strong>
          <%= inactiveNGOs %>
        </strong>

      </div>

    </div>


  </section>



  <!-- =====================================================
       SEARCH + FILTER
       ===================================================== -->

  <section class="ngo-management-controls">


    <!-- SEARCH -->

    <div class="ngo-search-wrapper">

      <label for="ngoSearchInput">
        Search NGOs
      </label>


      <div class="ngo-search-box">

        <i class="bi bi-search"></i>


        <input
          type="text"
          id="ngoSearchInput"
          placeholder="Search by NGO name, email, location..."
          autocomplete="off"
        />


        <button
          type="button"
          id="ngoClearSearch"
          class="ngo-clear-search"
        >
          Clear
        </button>

      </div>

    </div>



    <!-- FILTER -->

    <div class="ngo-filter-wrapper">

      <span>
        Filter by Status
      </span>


      <div
        class="ngo-filter-buttons"
        id="ngoFilterButtons"
      >


        <button
          type="button"
          class="ngo-filter-button active"
          data-filter="all"
        >
          All

          <span>
            <%= totalNGOs %>
          </span>

        </button>


        <button
          type="button"
          class="ngo-filter-button"
          data-filter="active"
        >
          Active

          <span>
            <%= activeNGOs %>
          </span>

        </button>


        <button
          type="button"
          class="ngo-filter-button"
          data-filter="inactive"
        >
          Inactive

          <span>
            <%= inactiveNGOs %>
          </span>

        </button>


      </div>

    </div>


  </section>



  <!-- =====================================================
       NGO LIST
       ===================================================== -->

  <section class="ngo-list-card">


    <!-- LIST HEADER -->

    <div class="ngo-list-header">

      <div>

        <h2>
          Registered NGOs
        </h2>


        <p>
          View NGO details and manage account status.
        </p>

      </div>


      <div class="ngo-result-count">

        <i class="bi bi-building-heart"></i>


        <span id="ngoResultCount">
          <%= totalNGOs %>
        </span>


        <span>
          NGOs
        </span>

      </div>

    </div>



    <!-- =================================================
         NGO TABLE
         ================================================= -->

    <% if (ngosList.length > 0) { %>


      <div class="ngo-table-wrapper">


        <table class="ngo-management-table">


          <thead>

            <tr>

              <th>
                NGO
              </th>

              <th>
                Email
              </th>

              <th>
                Contact
              </th>

              <th>
                Location
              </th>

              <th>
                Status
              </th>

              <th>
                Joined
              </th>

              <th class="ngo-actions-heading">
                Actions
              </th>

            </tr>

          </thead>



          <tbody id="ngoTableBody">


            <% ngosList.forEach((ngo) => { %>


              <tr
                class="ngo-management-row"
                data-status="<%= ngo.isOpen ? 'active' : 'inactive' %>"
                data-search="<%= getSearchText(ngo) %>"
              >


                <!-- NGO -->

                <td>

                  <div class="ngo-main-info">


                    <div class="ngo-management-image">

                      <img
                        src="<%= getNgoImage(ngo) %>"
                        alt="<%= getNgoName(ngo) %>"
                      />

                    </div>


                    <div class="ngo-name-info">

                      <strong>
                        <%= getNgoName(ngo) %>
                      </strong>


                      <span>
                        NGO account
                      </span>

                    </div>


                  </div>

                </td>



                <!-- EMAIL -->

                <td>

                  <% if (ngo.email) { %>


                    <a
                      href="mailto:<%= ngo.email %>"
                      class="ngo-email"
                    >

                      <i class="bi bi-envelope"></i>

                      <%= ngo.email %>

                    </a>


                  <% } else { %>


                    <span class="ngo-not-available">
                      Email not provided
                    </span>


                  <% } %>

                </td>



                <!-- CONTACT -->

                <td>

                  <% if (ngo.contactNumber) { %>


                    <span class="ngo-contact">

                      <i class="bi bi-telephone"></i>

                      <%= ngo.contactNumber %>

                    </span>


                  <% } else { %>


                    <span class="ngo-not-available">
                      Not provided
                    </span>


                  <% } %>

                </td>



                <!-- LOCATION -->

                <td>

                  <div class="ngo-location">

                    <i class="bi bi-geo-alt"></i>


                    <span>

                      <%= ngo.location ||
                          'Location not provided'
                      %>

                    </span>

                  </div>

                </td>



                <!-- STATUS -->

                <td>


                  <% if (ngo.isOpen) { %>


                    <span class="ngo-status active">

                      <span class="ngo-status-dot"></span>

                      Active

                    </span>


                  <% } else { %>


                    <span class="ngo-status inactive">

                      <span class="ngo-status-dot"></span>

                      Inactive

                    </span>


                  <% } %>


                </td>



                <!-- JOINED -->

                <td>

                  <span class="ngo-date">

                    <i class="bi bi-calendar3"></i>


                    <%= ngo.createdAt
                      ? new Date(
                          ngo.createdAt
                        ).toLocaleDateString(
                          'en-IN',
                          {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric'
                          }
                        )
                      : 'N/A'
                    %>


                  </span>

                </td>



                <!-- ACTIONS -->

                <td>


                  <div class="ngo-management-actions">


                    <!-- VIEW -->

                    <a
                      href="/admin/ngos/<%= ngo._id %>"
                      class="ngo-view-button"
                      title="View NGO details"
                    >

                      <i class="bi bi-eye"></i>

                      <span>
                        View
                      </span>

                    </a>



                    <!-- ENABLE / DISABLE -->

                    <form
                      action="/admin/ngos/<%= ngo._id %>/toggle"
                      method="POST"
                      class="ngo-toggle-form"
                    >


                      <% if (ngo.isOpen) { %>


                        <button
                          type="submit"
                          class="ngo-toggle-button disable"
                          title="Disable NGO"
                        >

                          <i class="bi bi-slash-circle"></i>

                          <span>
                            Disable
                          </span>

                        </button>


                      <% } else { %>


                        <button
                          type="submit"
                          class="ngo-toggle-button enable"
                          title="Enable NGO"
                        >

                          <i class="bi bi-check-circle"></i>

                          <span>
                            Enable
                          </span>

                        </button>


                      <% } %>


                    </form>


                  </div>


                </td>


              </tr>


            <% }) %>


          </tbody>


        </table>


      </div>



      <!-- =================================================
           SEARCH EMPTY STATE
           ================================================= -->

      <div
        id="ngoEmptyState"
        class="ngo-empty-state"
        style="display: none;"
      >


        <div class="ngo-empty-icon">

          <i class="bi bi-search"></i>

        </div>


        <h3>
          No NGOs found
        </h3>


        <p>
          Try another search term or change the status filter.
        </p>


        <button
          type="button"
          id="ngoResetFilters"
          class="ngo-reset-button"
        >
          Reset Filters
        </button>


      </div>


    <% } else { %>


      <!-- =================================================
           NO NGOs
           ================================================= -->

      <div class="ngo-empty-state">


        <div class="ngo-empty-icon">

          <i class="bi bi-building-heart"></i>

        </div>


        <h3>
          No NGOs available
        </h3>


        <p>
          Registered NGOs will appear here.
        </p>


      </div>


    <% } %>


  </section>


</div>



<!-- =======================================================
     SEARCH + FILTER JAVASCRIPT
     ======================================================= -->

<script>

(function () {

  'use strict';


  const searchInput =
    document.getElementById(
      'ngoSearchInput'
    );


  const clearButton =
    document.getElementById(
      'ngoClearSearch'
    );


  const filterButtons =
    document.getElementById(
      'ngoFilterButtons'
    );


  const rows =
    Array.from(
      document.querySelectorAll(
        '.ngo-management-row'
      )
    );


  const emptyState =
    document.getElementById(
      'ngoEmptyState'
    );


  const resultCount =
    document.getElementById(
      'ngoResultCount'
    );


  const resetButton =
    document.getElementById(
      'ngoResetFilters'
    );


  if (
    !searchInput ||
    !filterButtons
  ) {
    return;
  }


  let activeFilter = 'all';



  /* ==========================================
     NORMALIZE SEARCH TEXT
     ========================================== */

  const normalize = (value) => {

    return (
      value || ''
    )
      .trim()
      .toLowerCase();

  };



  /* ==========================================
     APPLY SEARCH + FILTER
     ========================================== */

  const applyFilters = () => {


    const query =
      normalize(
        searchInput.value
      );


    let visibleCount = 0;


    rows.forEach((row) => {


      const status =
        row.dataset.status ||
        'inactive';


      const searchable =
        normalize(
          row.dataset.search
        );


      const matchesSearch =
        !query ||
        searchable.includes(
          query
        );


      const matchesFilter =
        activeFilter === 'all' ||
        status === activeFilter;


      const shouldShow =
        matchesSearch &&
        matchesFilter;


      row.style.display =
        shouldShow
          ? ''
          : 'none';


      if (shouldShow) {

        visibleCount++;

      }

    });



    /* Update count */

    if (resultCount) {

      resultCount.textContent =
        visibleCount;

    }



    /* Empty state */

    if (emptyState) {

      emptyState.style.display =
        visibleCount === 0
          ? 'flex'
          : 'none';

    }

  };



  /* ==========================================
     SEARCH
     ========================================== */

  searchInput.addEventListener(
    'input',
    applyFilters
  );



  /* ==========================================
     CLEAR SEARCH
     ========================================== */

  if (clearButton) {

    clearButton.addEventListener(
      'click',
      () => {

        searchInput.value = '';

        applyFilters();

        searchInput.focus();

      }
    );

  }



  /* ==========================================
     FILTER
     ========================================== */

  filterButtons.addEventListener(
    'click',
    (event) => {


      const button =
        event.target.closest(
          '.ngo-filter-button'
        );


      if (!button) {
        return;
      }


      activeFilter =
        button.dataset.filter ||
        'all';


      filterButtons
        .querySelectorAll(
          '.ngo-filter-button'
        )
        .forEach((item) => {

          item.classList.toggle(
            'active',
            item === button
          );

        });


      applyFilters();

    }
  );



  /* ==========================================
     RESET
     ========================================== */

  if (resetButton) {

    resetButton.addEventListener(
      'click',
      () => {


        searchInput.value = '';

        activeFilter = 'all';


        filterButtons
          .querySelectorAll(
            '.ngo-filter-button'
          )
          .forEach((button) => {

            button.classList.toggle(
              'active',
              button.dataset.filter === 'all'
            );

          });


        applyFilters();

      }
    );

  }



  /* INITIAL */

  applyFilters();


})();

</script>