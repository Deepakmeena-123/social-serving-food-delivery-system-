<% layout('layouts/boilerplate')%>
<!-- Menu of Restaurant -->
<div class="restaurant-menu-page mb-1">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="menu-title mb-0"><%= restaurant.username%></h1>
    <% if(currentUser && currentUser._id && currentUser._id.equals(restaurant._id)) { %>
      <a class="btn btn-outline-secondary" href="/restaurants/<%= restaurant._id %>/dashboard">Dashboard</a>
    <% } %>
  </div>
  <% if(currentUser && restaurant._id.equals(currentUser._id)) { %> <%
  if(restaurant.isOpen){ %>
  <a class="btn btn-primary mb-2" href="/restaurants/<%=restaurant._id%>/add"
    >Add Food
  </a>
  <% } %> <% } %> <% for (let food of restaurant.cart){ %>
  <div class="card mb-3 restaurant-menu-card">
    <div class="row">
      <div class="col-md-4">
        <%if(food.food.image.url) {%>
        <img class="restaurant-menu-image" alt="" src="<%=food.food.image.url%>" />
        <% }else {%>
        <img
          class="restaurant-menu-image"
          alt=""
          src="https://openclipart.org/image/800px/289282"
        />
        <% } %>
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <h5 class="card-title"><%= food.food.name %></h5>
          <p class="card-text"><%= food.food.description %></p>
          <p class="card-text restaurant-price">
            <small class="text-muted">
              <% if(currentUser.roles === 'restaurant' || currentUser.roles ===
              'Admin') {%> ₹ <%= food.food.price %> <% } else { %>
              <span style="color: red; text-decoration: line-through;">₹<%= food.food.price %></span>
              <% if(currentUser.roles === 'customer') {%> ₹<%=
              0.8*food.food.price %> <% } else { %> ₹<%= 0.6*food.food.price %>
              <% } %> <% } %>
            </small>
          </p>
          <strong>Number Of Plates: <%= food.food.count %></strong>
          <% if(currentUser && restaurant._id.equals(currentUser._id)) { %>
          <div class="mt-2 restaurant-actions">
            <% if(restaurant.isOpen){ %>
            <a
              class="btn btn-info mb-2"
              href="/restaurants/<%=restaurant._id%>/<%= food.food._id %>/edit"
              >Edit
            </a>
            <% } %>
            <form
              class="d-inline"
              action="/restaurants/<%=restaurant._id%>/<%=food.food._id%>?_method=DELETE"
              method="POST"
            >
              <% if(restaurant.isOpen){ %>
              <button class="btn btn-danger mb-2">Remove</button>
              <% } %>
            </form>
          </div>
          <% } else if(currentUser && (currentUser.roles === 'NGO' ||
          currentUser.roles === 'customer')) { %>

          <form action="/restaurants/<%= food.food._id %>/add" method="post">
            <input
              class="form-control d-inline-block mb-2"
              style="max-width: 120px;"
              type="number"
              value="0"
              min="1"
              max="<%= food.food.count %>"
              name="count"
            />
            <% if(currentUser.isOpen){ %>
            <button class="btn btn-primary mb-2">Add To Cart</button>
            <button
              class="btn btn-success mb-2"
              formaction="/cart/place-order/<%= food.food._id %>"
              formmethod="POST"
            >
              Place Order
            </button>
            <% } %>
          </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% }%>
</div>
