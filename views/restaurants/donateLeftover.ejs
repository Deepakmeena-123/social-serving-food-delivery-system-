<% layout('layouts/boilerplate')%>
<div class="container">
  <h1 class="mb-4">Donate Leftover Food</h1>

  <div class="card mb-4">
    <div class="row g-0 align-items-center">
      <div class="col-md-4">
        <% if(food.image.url) { %>
          <img class="img-fluid rounded-start" src="<%= food.image.url %>" alt="<%= food.name %>" />
        <% } else { %>
          <img class="img-fluid rounded-start" src="https://openclipart.org/image/800px/289282" alt="<%= food.name %>" />
        <% } %>
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <h4 class="card-title"><%= food.name %></h4>
          <p class="card-text mb-1"><strong>Description:</strong> <%= food.description %></p>
          <p class="card-text mb-1"><strong>Available Plates:</strong> <%= food.count %></p>
          <p class="card-text mb-0"><strong>Restaurant:</strong> <%= food.restaurant.username %></p>
        </div>
      </div>
    </div>
  </div>

  <form action="/restaurants/<%= food.restaurant._id %>/<%= food._id %>/donate-leftover" method="POST" class="card p-4">
    <div class="mb-3">
      <label class="form-label" for="count">Quantity to Donate</label>
      <input
        type="number"
        class="form-control"
        id="count"
        name="count"
        min="1"
        max="<%= food.count %>"
        value="<%= food.count %>"
        required
      />
    </div>

    <div class="mb-3">
      <label class="form-label" for="NGO">Select NGO</label>
      <select class="form-select" id="NGO" name="NGO" required>
        <option value="">Choose NGO</option>
        <% for (let ngo of ngos) { %>
          <option value="<%= ngo._id %>"><%= ngo.username %> - <%= ngo.location %></option>
        <% } %>
      </select>
    </div>

    <div>
      <button class="btn btn-success">Donate Leftover Food</button>
      <a href="/restaurants/<%= food.restaurant._id %>" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>