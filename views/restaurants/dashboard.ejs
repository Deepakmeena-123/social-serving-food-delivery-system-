<% layout('layouts/boilerplate') %>

<div class="restaurant-dashboard container py-4">
  <div class="row g-4 align-items-start">
    <aside class="col-lg-3">
      <div class="restaurant-sidebar card border-0 shadow-sm h-100">
        <div class="card-body p-3">
          <div class="restaurant-brand mb-4">
            <div class="restaurant-brand-icon">FB</div>
            <div>
              <h5 class="mb-0">FoodBridge</h5>
              <small class="text-muted">Restaurant</small>
            </div>
          </div>

          <nav class="nav flex-column restaurant-nav">
            <a class="nav-link active" href="/restaurants/<%= restaurant._id %>/dashboard"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a class="nav-link" href="/restaurants/<%= restaurant._id %>/orders"><i class="bi bi-bag-check"></i> Orders</a>
            <a class="nav-link" href="/restaurants/<%= restaurant._id %>"><i class="bi bi-card-list"></i> Menu</a>
            <a class="nav-link" href="/restaurants/<%= restaurant._id %>/donations"><i class="bi bi-gift"></i> Donations</a>
            <a class="nav-link" href="/restaurants/<%= restaurant._id %>/donations/history"><i class="bi bi-clock-history"></i> Donation History</a>
            <a class="nav-link" href="/profile/<%= restaurant._id %>"><i class="bi bi-person-circle"></i> Profile</a>
            <a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
          </nav>
        </div>
      </div>
    </aside>

    <main class="col-lg-9">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <p class="text-muted mb-1">Welcome back</p>
          <h1 class="mb-0"><%= restaurant.username %></h1>
        </div>
        <a href="/restaurants/<%= restaurant._id %>/add" class="btn btn-success">
          <i class="bi bi-plus-circle"></i> Add Food
        </a>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
          <div class="card dashboard-stat-card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="stat-top">
                <span class="stat-label">Total Food Items</span>
                <span class="stat-icon green"><i class="bi bi-basket"></i></span>
              </div>
              <h3 class="mt-3 mb-0"><%= totalFoodItems %></h3>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-xl-3">
          <div class="card dashboard-stat-card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="stat-top">
                <span class="stat-label">Total Orders</span>
                <span class="stat-icon orange"><i class="bi bi-bag"></i></span>
              </div>
              <h3 class="mt-3 mb-0"><%= totalOrders %></h3>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-xl-3">
          <div class="card dashboard-stat-card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="stat-top">
                <span class="stat-label">Total Donations</span>
                <span class="stat-icon green"><i class="bi bi-gift-fill"></i></span>
              </div>
              <h3 class="mt-3 mb-0"><%= totalDonations %></h3>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-xl-3">
          <div class="card dashboard-stat-card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="stat-top">
                <span class="stat-label">Pending Orders</span>
                <span class="stat-icon orange"><i class="bi bi-hourglass-split"></i></span>
              </div>
              <h3 class="mt-3 mb-0"><%= pendingOrders %></h3>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
              <h5 class="mb-0">Recent Orders</h5>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table mb-0 align-middle">
                  <thead class="table-light">
                    <tr>
                      <th>Order ID</th>
                      <th>Customer</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!recentOrders || recentOrders.length === 0) { %>
                      <tr>
                        <td colspan="3" class="text-muted text-center py-4">No recent orders found.</td>
                      </tr>
                    <% } else { %>
                      <% for (const order of recentOrders) { %>
                        <tr>
                          <td>#<%= order._id.toString().slice(-6) %></td>
                          <td><%= order.user ? order.user.username : 'Customer' %></td>
                          <td>
                            <% if (order.status === 'Delivered') { %>
                              <span class="badge bg-success">Delivered</span>
                            <% } else if (order.status === 'Pending') { %>
                              <span class="badge bg-warning text-dark">Pending</span>
                            <% } else if (order.status === 'Cancelled') { %>
                              <span class="badge bg-danger">Cancelled</span>
                            <% } else { %>
                              <span class="badge bg-secondary"><%= order.status %></span>
                            <% } %>
                          </td>
                        </tr>
                      <% } %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
              <h5 class="mb-0">Recent Donations</h5>
            </div>
            <div class="card-body p-0">
              <div class="list-group list-group-flush">
                <% if (!recentDonations || recentDonations.length === 0) { %>
                  <div class="p-3 text-muted text-center">No recent donations found.</div>
                <% } else { %>
                  <% for (const donation of recentDonations) { %>
                    <div class="list-group-item">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <strong><%= donation.foodName %></strong>
                          <div class="text-muted small"><%= donation.donatedQuantity %> plates</div>
                        </div>
                        <span class="badge bg-light text-dark"><%= donation.status %></span>
                      </div>
                    </div>
                  <% } %>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
