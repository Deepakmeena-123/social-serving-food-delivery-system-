<% layout('layouts/boilerplate') %>

<div class="restaurant-dashboard container py-4">

  <div class="row g-4 align-items-start">

    <!-- =====================================================
         RESTAURANT SIDEBAR
    ====================================================== -->
    <aside class="col-lg-3">

      <div class="restaurant-sidebar card border-0 shadow-sm h-100">

        <div class="card-body p-3">

          <!-- Brand -->
          <div class="restaurant-brand mb-4">

            <div class="restaurant-brand-icon">
              FB
            </div>

            <div>
              <h5 class="mb-0">
                FoodBridge
              </h5>

              <small class="text-muted">
                Restaurant
              </small>
            </div>

          </div>


          <!-- Navigation -->
          <nav class="nav flex-column restaurant-nav">

            <a
              class="nav-link"
              href="/restaurants/<%= restaurant._id %>/dashboard"
            >
              <i class="bi bi-grid-1x2-fill"></i>
              Dashboard
            </a>


            <a
              class="nav-link active"
              href="/restaurants/<%= restaurant._id %>/orders"
            >
              <i class="bi bi-bag-check"></i>
              Orders
            </a>


            <a
              class="nav-link"
              href="/restaurants/<%= restaurant._id %>"
            >
              <i class="bi bi-card-list"></i>
              Menu
            </a>


            <a
              class="nav-link"
              href="/restaurants/<%= restaurant._id %>/donations"
            >
              <i class="bi bi-gift"></i>
              Donations
            </a>


            <a
              class="nav-link"
              href="/restaurants/<%= restaurant._id %>/donations/history"
            >
              <i class="bi bi-clock-history"></i>
              Donation History
            </a>


            <a
              class="nav-link"
              href="/profile/<%= restaurant._id %>"
            >
              <i class="bi bi-person-circle"></i>
              Profile
            </a>


            <a
              class="nav-link text-danger"
              href="/logout"
            >
              <i class="bi bi-box-arrow-right"></i>
              Logout
            </a>

          </nav>

        </div>

      </div>

    </aside>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->
    <main class="col-lg-9">

      <!-- Page heading -->
      <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

          <p class="text-muted mb-1">
            Restaurant orders
          </p>

          <h1 class="mb-0">
            Orders
          </h1>

        </div>

      </div>



      <!-- =====================================================
           ORDERS TABLE
      ====================================================== -->

      <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

          <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

              <!-- TABLE HEADER -->
              <thead class="table-light">

                <tr>

                  <th>
                    Order ID
                  </th>

                  <th>
                    Customer
                  </th>

                  <th>
                    Items
                  </th>

                  <th>
                    Amount
                  </th>

                  <th>
                    Payment
                  </th>

                  <th>
                    Payment Status
                  </th>

                  <th>
                    Status
                  </th>

                  <th>
                    Date
                  </th>

                  <th>
                    Action
                  </th>

                </tr>

              </thead>



              <!-- TABLE BODY -->
              <tbody>

                <% if (!orders || orders.length === 0) { %>

                  <tr>

                    <td
                      colspan="9"
                      class="text-center text-muted py-4"
                    >
                      No orders found.
                    </td>

                  </tr>

                <% } else { %>


                  <% for (const order of orders) { %>

                    <%
                      /*
                       * Determine payment status.
                       *
                       * COD:
                       *     payment status = COD
                       *
                       * ONLINE:
                       *     Paid / Failed / Pending
                       */
                      const paymentStatus =
                        order.paymentStatus ||
                        (
                          order.modeOfPayment === 'COD'
                            ? 'COD'
                            : order.status === 'Success'
                              ? 'Paid'
                              : order.status === 'Failed'
                                ? 'Failed'
                                : 'Pending'
                        );


                      /*
                       * Restaurant can manage:
                       *
                       * COD orders immediately.
                       *
                       * ONLINE orders only after payment
                       * has been completed.
                       */
                      const canManageOrder =
                        order.modeOfPayment !== 'ONLINE' ||
                        paymentStatus === 'Paid';
                    %>



                    <!-- =================================================
                         ORDER ROW
                    ================================================== -->

                    <tr>


                      <!-- ORDER ID -->
                      <td>

                        #<%= order._id.toString().slice(-6) %>

                      </td>



                      <!-- CUSTOMER -->
                      <td>

                        <%= order.user
                          ? order.user.username
                          : 'Customer'
                        %>

                      </td>



                      <!-- ITEMS -->
                      <td>

                        <% if (
                          order.order &&
                          order.order.length
                        ) { %>


                          <%
                            const itemNames =
                              order.order.map(
                                item =>
                                  item.food &&
                                  item.food.name
                                    ? item.food.name
                                    : 'Item'
                              );
                          %>


                          <%= itemNames.join(', ') %>


                        <% } else { %>

                          -

                        <% } %>

                      </td>



                      <!-- AMOUNT -->
                      <td>

                        ₹<%= order.money || 0 %>

                      </td>



                      <!-- PAYMENT METHOD -->
                      <td>

                        <%= order.modeOfPayment || 'N/A' %>

                      </td>



                      <!-- =================================================
                           PAYMENT STATUS
                      ================================================== -->

                      <td>

                        <% if (paymentStatus === 'Paid') { %>

                          <span class="badge bg-success px-2 py-1">

                            <i class="bi bi-check-circle me-1"></i>

                            Paid

                          </span>


                        <% } else if (paymentStatus === 'COD') { %>

                          <span class="badge bg-success px-2 py-1">

                            COD

                          </span>


                        <% } else if (paymentStatus === 'Failed') { %>

                          <span class="badge bg-danger px-2 py-1">

                            <i class="bi bi-x-circle me-1"></i>

                            Failed

                          </span>


                        <% } else { %>

                          <span class="badge bg-warning text-dark px-2 py-1">

                            <i class="bi bi-clock me-1"></i>

                            Pending

                          </span>

                        <% } %>

                      </td>



                      <!-- =================================================
                           ORDER STATUS
                      ================================================== -->

                      <td>

                        <% if (order.status === 'Delivered') { %>

                          <span class="badge bg-success">

                            Delivered

                          </span>


                        <% } else if (order.status === 'Pending') { %>

                          <span class="badge bg-warning text-dark">

                            Pending

                          </span>


                        <% } else if (order.status === 'Cancelled') { %>

                          <span class="badge bg-danger">

                            Cancelled

                          </span>


                        <% } else if (order.status === 'Rejected') { %>

                          <span class="badge bg-danger">

                            Rejected

                          </span>


                        <% } else if (order.status === 'OutForDelivery') { %>

                          <span class="badge bg-info text-dark">

                            Out for Delivery

                          </span>


                        <% } else if (order.status === 'Preparing') { %>

                          <span class="badge bg-secondary">

                            Preparing

                          </span>


                        <% } else if (order.status === 'Confirmed') { %>

                          <span class="badge bg-secondary">

                            Confirmed

                          </span>


                        <% } else { %>

                          <span class="badge bg-secondary">

                            <%= order.status || 'Unknown' %>

                          </span>

                        <% } %>

                      </td>



                      <!-- DATE -->
                      <td>

                        <%= order.createdAt
                          ? new Date(
                              order.createdAt
                            ).toLocaleDateString()
                          : 'N/A'
                        %>

                      </td>



                      <!-- =================================================
                           ACTION
                      ================================================== -->

                      <td>

                        <!--
                          RESTAURANT CAN MANAGE THE ORDER
                          ONLY WHEN:
                          1. COD
                          2. ONLINE PAYMENT IS PAID
                        -->

                        <% if (
                          canManageOrder &&
                          order.status === 'Pending'
                        ) { %>


                          <div class="d-flex gap-1">


                            <!-- CONFIRM -->
                            <form
                              action="/restaurants/<%= restaurant._id %>/orders/<%= order._id %>/status"
                              method="POST"
                            >

                              <input
                                type="hidden"
                                name="status"
                                value="Confirmed"
                              >

                              <button
                                type="submit"
                                class="btn btn-sm btn-success"
                              >
                                Confirm
                              </button>

                            </form>



                            <!-- REJECT -->
                            <form
                              action="/restaurants/<%= restaurant._id %>/orders/<%= order._id %>/status"
                              method="POST"
                            >

                              <input
                                type="hidden"
                                name="status"
                                value="Rejected"
                              >

                              <button
                                type="submit"
                                class="btn btn-sm btn-outline-danger"
                              >
                                Reject
                              </button>

                            </form>

                          </div>



                        <% } else if (
                          canManageOrder &&
                          order.status === 'Confirmed'
                        ) { %>


                          <!-- START PREPARING -->
                          <form
                            action="/restaurants/<%= restaurant._id %>/orders/<%= order._id %>/status"
                            method="POST"
                          >

                            <input
                              type="hidden"
                              name="status"
                              value="Preparing"
                            >

                            <button
                              type="submit"
                              class="btn btn-sm btn-primary"
                            >
                              Start Preparing
                            </button>

                          </form>



                        <% } else if (
                          canManageOrder &&
                          order.status === 'Preparing'
                        ) { %>


                          <!-- OUT FOR DELIVERY -->
                          <form
                            action="/restaurants/<%= restaurant._id %>/orders/<%= order._id %>/status"
                            method="POST"
                          >

                            <input
                              type="hidden"
                              name="status"
                              value="OutForDelivery"
                            >

                            <button
                              type="submit"
                              class="btn btn-sm btn-primary"
                            >
                              Out for Delivery
                            </button>

                          </form>



                        <% } else { %>


                          <!-- NO ACTION -->
                          <span class="text-muted small">
                            —
                          </span>


                        <% } %>

                      </td>

                    </tr>


                  <% } %>


                <% } %>

              </tbody>

            </table>

          </div>

        </div>

      </div>

    </main>

  </div>

</div>