<% layout('layouts/boilerplate') %>

<div class="restaurant-dashboard container py-4">
  <div class="row g-4 align-items-start">
    <aside class="col-lg-3">
      <div class="restaurant-sidebar card border-0 shadow-sm h-100">
        <div class="card-body p-3">
          <div class="restaurant-brand mb-4">
            <div class="restaurant-brand-icon">FB</div>
            <div>
              <h5 class="mb-0">FoodBridge</h5>
              <small class="text-muted">Restaurant</small>
            </div>
          </div>

          <nav class="nav flex-column restaurant-nav">
            <a class="nav-link" href="/restaurants/<%= restaurant._id %>/dashboard"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a class="nav-link active" href="/restaurants/<%= restaurant._id %>/orders"><i class="bi bi-bag-check"></i> Orders</a>
            <a class="nav-link" href="/restaurants/<%= restaurant._id %>"><i class="bi bi-card-list"></i> Menu</a>
            <a class="nav-link" href="/restaurants/<%= restaurant._id %>/donations"><i class="bi bi-gift"></i> Donations</a>
            <a class="nav-link" href="/restaurants/<%= restaurant._id %>/donations/history"><i class="bi bi-clock-history"></i> Donation History</a>
            <a class="nav-link" href="/profile/<%= restaurant._id %>"><i class="bi bi-person-circle"></i> Profile</a>
            <a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
          </nav>
        </div>
      </div>
    </aside>

    <main class="col-lg-9">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <p class="text-muted mb-1">Restaurant orders</p>
          <h1 class="mb-0">Orders</h1>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Order ID</th>
                  <th>Customer</th>
                  <th>Items</th>
                  <th>Amount</th>
                  <th>Payment</th>
                  <th>Payment Status</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (!orders || orders.length === 0) { %>
                  <tr>
                    <td colspan="9" class="text-center text-muted py-4">No orders found.</td>
                  </tr>
                <% } else { %>
                  <% for (const order of orders) { %>
                    <% const paymentStatus = order.paymentStatus || (order.modeOfPayment === 'COD' ? 'COD' : order.status === 'Success' ? 'Paid' : order.status === 'Failed' ? 'Failed' : 'Pending'); %>
                    <% const canManageOrder = order.modeOfPayment !== 'ONLINE' || paymentStatus === 'Paid'; %>
                    <tr>
                      <td>#<%= order._id.toString().slice(-6) %></td>
                      <td><%= order.user ? order.user.username : 'Customer' %></td>
                      <td>
                        <% if (order.order && order.order.length) { %>
                          <% const itemNames = order.order.map(item => item.food && item.food.name ? item.food.name : 'Item'); %>
                          <%= itemNames.join(', ') %>
                        <% } else { %>
                          -
                        <% } %>
                      </td>
                      <td>₹<%= order.money || 0 %></td>
                      <td><%= order.modeOfPayment || 'N/A' %></td>
                      <td><span class="badge <%= paymentStatus === 'Paid' || paymentStatus === 'COD' ? 'bg-success' : paymentStatus === 'Failed' ? 'bg-danger' : 'bg-warning text-dark' %>"><%= paymentStatus %></span></td>
                      <td>
                        <% if (order.status === 'Delivered') { %>
                          <span class="badge bg-success">Delivered</span>
                        <% } else if (order.status === 'Pending') { %>
                          <span class="badge bg-warning text-dark">Pending</span>
                        <% } else if (order.status === 'Cancelled') { %>
                          <span class="badge bg-danger">Cancelled</span>
                        <% } else if (order.status === 'Rejected') { %>
                          <span class="badge bg-danger">Rejected</span>
                        <% } else if (order.status === 'OutForDelivery') { %>
                          <span class="badge bg-info text-dark">Out for Delivery</span>
                        <% } else { %>
                          <span class="badge bg-secondary"><%= order.status %></span>
                        <% } %>
                      </td>
                      <td><%= order.createdAt ? new Date(order.createdAt).toLocaleDateString() : 'N/A' %></td>
                      <td>
                        <% if (canManageOrder && order.status === 'Pending') { %>
                          <div class="d-flex gap-1">
                            <form action="/restaurants/<%= restaurant._id %>/orders/<%= order._id %>/status" method="POST"><input type="hidden" name="status" value="Confirmed"><button class="btn btn-sm btn-success">Confirm</button></form>
                            <form action="/restaurants/<%= restaurant._id %>/orders/<%= order._id %>/status" method="POST"><input type="hidden" name="status" value="Rejected"><button class="btn btn-sm btn-outline-danger">Reject</button></form>
                          </div>
                        <% } else if (canManageOrder && order.status === 'Confirmed') { %>
                          <form action="/restaurants/<%= restaurant._id %>/orders/<%= order._id %>/status" method="POST"><input type="hidden" name="status" value="Preparing"><button class="btn btn-sm btn-primary">Start Preparing</button></form>
                        <% } else if (canManageOrder && order.status === 'Preparing') { %>
                          <form action="/restaurants/<%= restaurant._id %>/orders/<%= order._id %>/status" method="POST"><input type="hidden" name="status" value="OutForDelivery"><button class="btn btn-sm btn-primary">Out for Delivery</button></form>
                        <% } else { %>
                          <span class="text-muted small">—</span>
                        <% } %>
                      </td>
                    </tr>
                  <% } %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
