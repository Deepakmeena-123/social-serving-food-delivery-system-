<% layout('layouts/boilerplate') %>
<!-- Direct Order Confirmation Page -->
<div class="container">
  <h1 class="mb-4">Confirm Your Order</h1>
  <div class="card mb-4">
    <div class="row g-0 align-items-center">
      <div class="col-md-4">
        <img
          class="img-fluid rounded-start"
          src="<%= food.image.url ? food.image.url : 'https://openclipart.org/image/800px/289282' %>"
          alt="<%= food.name %>"
          style="width: 100%; object-fit: cover;"
        />
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <h4 class="card-title"><%= food.name %></h4>
          <p class="card-text mb-1"><strong>Restaurant:</strong> <%= food.restaurant.username %></p>
          <p class="card-text mb-1"><strong>Quantity:</strong> <%= quantity %></p>
          <p class="card-text mb-1"><strong>Food Total:</strong> ₹<%= discountedAmount %></p>
          <p class="card-text mb-1"><strong>Delivery Charges:</strong> ₹<%= delivery %></p>
          <p class="card-text mb-0"><strong>Grand Total:</strong> ₹<%= total %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body d-flex flex-wrap gap-3 align-items-center justify-content-between">
      <div>
        <h5 class="mb-1">Choose Payment Method</h5>
        <p class="mb-0 text-muted">Complete this order without adding it to your cart.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/cart/direct/pay/cod" class="btn btn-primary">Cash on Delivery</a>
        <button class="btn btn-success" id="direct-rzp-button">Online Payment</button>
      </div>
    </div>
  </div>
</div>

<script>
  const headers = {
    'Content-Type': 'application/json',
  };

  document.getElementById('direct-rzp-button').onclick = function (e) {
    e.preventDefault();
    axios
      .post('/cart/direct/pay/online', {}, { headers })
      .then((info) => {
        const options = {
          key: '<%= process.env.RAZORPAY_KEY %>',
          name: '<%= currentUser.username %>',
          description: '<%= food.name %>',
          image: '<%= currentUser.image && currentUser.image.url ? currentUser.image.url : "https://openclipart.org/image/800px/289282" %>',
          order_id: info.data.id,
          callback_url: '/cart/direct/verify',
          theme: {
            color: '#3399cc',
          },
        };
        const rzp1 = new Razorpay(options);
        rzp1.open();
      });
  };
</script>