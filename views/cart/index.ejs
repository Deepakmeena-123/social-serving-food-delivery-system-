<% layout('layouts/boilerplate')%>
<!-- CART PAGE -->
<div class="container py-4 customer-cart-page">
  <div class="mb-4">
    <p class="text-muted mb-1">Shopping cart</p>
    <h1 class="mb-0"><%= currentUser.username %>'s Cart</h1>
    <p class="text-muted mb-0">Delivery Address: <%= currentUser.location %></p>
  </div>

  <% for (let food of cart){%>
  <div class="card mb-3 border-0 shadow-sm customer-cart-item-card">
    <div class="row g-0">
      <div class="col-md-3 d-flex align-items-center justify-content-center p-2">
        <%if(food.food.image.url) {%>
        <img class="img-fluid" alt="" src="<%=food.food.image.url%>" />
        <% }else {%>
        <img
          class="img-fluid"
          alt=""
          style="height: 13rem;"
          src="https://openclipart.org/image/800px/289282"
        />
        <% } %>
      </div>
      <div class="col-md-9">
        <div class="card-body">
          <div class="mb-2 d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <label class="form-check-label">
              <input
                type="checkbox"
                class="form-check-input selected-food-checkbox"
                value="<%= food.food._id %>"
                data-count="<%= food.count %>"
                data-unit-price="<%= currentUser.roles === 'customer' ? (0.8 * food.food.price) : (0.6 * food.food.price) %>"
                data-rest-lat="<%= food.food.restaurant.geometry['coordinates'][1] %>"
                data-rest-lng="<%= food.food.restaurant.geometry['coordinates'][0] %>"
              />
              Select this item
            </label>
            <span class="badge bg-light text-dark">Qty: <%= food.count %></span>
          </div>
          <h5 class="card-title"><%= food.food.name %></h5>
          <p class="card-text">
            <small class="d-block"
              >Restaurant: <%= food.food.restaurant.username%></small
            >
            <small class="text-muted d-block"
              ><%= food.food.restaurant.location%></small
            >

            Price: <span style="color: red; text-decoration: line-through;">₹<%= food.food.price %></span>
            <% if(currentUser.roles === 'customer') {%> ₹<%= 0.8*food.food.price
            %> <% } else { %> ₹<%= 0.6*food.food.price %> <% } %>
          </p>
          <form action="/cart/<%=food.food._id%>?_method=PUT" method="post" class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <strong>
              Quantity:
              <input
                type="number"
                class="mx-2 form-control d-inline-block"
                style="max-width: 110px;"
                id="count"
                value="<%= food.count %>"
                aria-label="count"
                aria-describedby="count-label"
                name="count"
                min="1"
                max="<%= (food.count + food.food.count)%>"
                required
              /><button class="btn btn-primary btn-sm">
                Save Changes
              </button>
            </strong>
          </form>
          <div class="d-flex flex-wrap gap-2">
            <form
              action="/cart/<%=food.food._id%>?_method=DELETE"
              class="d-inline"
              method="post"
            >
              <button class="btn btn-outline-danger btn-sm">Remove</button>
            </form>
            <a
              class="btn btn-outline-primary btn-sm"
              href="/restaurants/<%=food.food.restaurant._id%>"
              >View Restaurant</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
  <% }%>
  <div class="card mb-3 border-0 shadow-sm">
    <div class="row g-0">
      <div class="col-md-4 border-end">
        <div class="card-body">
            <strong class="d-block mb-2">Subtotal + Delivery</strong>
            <div class="text-muted">Delivery Charges: ₹<span id="selected-delivery">0.00</span></div>
            <h5 class="mt-2 mb-0">Total: ₹<span id="selected-total">0.00</span></h5>
        </div>
      </div>
      <div class="col-md-8">
        <div class="card-body d-flex flex-wrap gap-2">
          <button class="btn btn-primary" id="place-order-btn">Proceed to Checkout</button>
          <% if(currentUser.roles !== 'restaurant' && currentUser.roles !== 'Admin') {%>
          <button class="btn btn-outline-success" id="donate-selected-btn">Donate Selected Food</button>
          <% } %>
          <a href="/cart/pay/cod" class="btn btn-outline-primary <%= money === 0?'disabled':''%>">Order All (COD)</a>
        </div>
      </div>
    </div>
  </div>
</div>

<form id="selected-place-order-form" action="/cart/selection" method="POST"></form>
<form id="selected-donation-form" action="/cart/selection/donation" method="POST"></form>

<script>
  const userLat = <%= currentUser.geometry['coordinates'][1] %>;
  const userLng = <%= currentUser.geometry['coordinates'][0] %>;

  function calculateDelivery(restLat, restLng) {
    const latDiff = (userLat * Math.PI / 180) - (restLat * Math.PI / 180);
    const lngDiff = (userLng * Math.PI / 180) - (restLng * Math.PI / 180);
    const a = (Math.sin(latDiff / 2) ** 2) +
      Math.cos(userLat * Math.PI / 180) *
      Math.cos(restLat * Math.PI / 180) *
      (Math.sin(lngDiff / 2) ** 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    const distance = c * 6371;
    if (distance < 2) return 0;
    return Math.round((5 * distance) * 100) / 100;
  }

  function updateSelectedTotals() {
    const selected = Array.from(document.querySelectorAll('.selected-food-checkbox:checked'));
    let subtotal = 0;
    let delivery = 0;

    selected.forEach((checkbox, index) => {
      const count = Number(checkbox.dataset.count || 0);
      const unitPrice = Number(checkbox.dataset.unitPrice || 0);
      subtotal += (count * unitPrice);

      if (index === 0) {
        const restLat = Number(checkbox.dataset.restLat || 0);
        const restLng = Number(checkbox.dataset.restLng || 0);
        delivery = calculateDelivery(restLat, restLng);
      }
    });

    const total = Math.round((subtotal + delivery) * 100) / 100;
    document.getElementById('selected-delivery').textContent = delivery.toFixed(2);
    document.getElementById('selected-total').textContent = total.toFixed(2);
  }

  function appendSelectedInputs(form) {
    form.innerHTML = '';
    const selected = document.querySelectorAll('.selected-food-checkbox:checked');
    selected.forEach((checkbox) => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'selectedFoodIds';
      input.value = checkbox.value;
      form.appendChild(input);
    });
    return selected.length;
  }

  document.getElementById('place-order-btn')?.addEventListener('click', function (e) {
    e.preventDefault();
    const form = document.getElementById('selected-place-order-form');
    const count = appendSelectedInputs(form);
    if (count === 0) {
      alert('Please select at least one food item.');
      return;
    }
    form.submit();
  });

  document.getElementById('donate-selected-btn')?.addEventListener('click', function (e) {
    e.preventDefault();
    const form = document.getElementById('selected-donation-form');
    const count = appendSelectedInputs(form);
    if (count === 0) {
      alert('Please select at least one food item.');
      return;
    }
    form.submit();
  });

  document.querySelectorAll('.selected-food-checkbox').forEach((checkbox) => {
    checkbox.addEventListener('change', updateSelectedTotals);
  });

  updateSelectedTotals();
</script>
