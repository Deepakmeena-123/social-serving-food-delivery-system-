<% layout('layouts/boilerplate')%> <% let money = 0 %>
<!-- Selecting NGO Page -->
<div class="container py-4 customer-donation-page">
  <div class="mb-4">
    <p class="text-muted mb-1">Donate from cart</p>
    <h1 class="mb-0">Donate Food</h1>
    <p class="text-muted mb-0">Select an NGO and continue with the existing donation payment flow.</p>
  </div>

  <% for (let food of cart){%>
  <div class="card mb-3 border-0 shadow-sm">
    <div class="row g-0">
      <div class="col-md-3 d-flex align-items-center justify-content-center p-2">
        <%if(food.food.image.url) {%>
        <img class="img-fluid" alt="" src="<%=food.food.image.url%>" />
        <% }else {%>
        <img
          class="img-fluid"
          alt=""
          src="https://acadianakarate.com/wp-content/uploads/2017/04/default-image-620x600.jpg"
        />
        <% } %>
      </div>
      <div class="col-md-9">
        <div class="card-body">
          <h5 class="card-title"><%= food.food.name %></h5>
          <p class="card-text">
            <small class="d-block"
              >Restaurant: <%= food.food.restaurant.username%></small
            >
            <small class="text-muted d-block"
              ><%= food.food.restaurant.location%></small
            >
            <strong class="d-block"
              >Number of Plates:
              <input
                type="number"
                class="mx-2"
                id="count"
                value="<%= food.count %>"
                aria-label="count"
                aria-describedby="count-label"
                name="count"
                min="1"
                max="<%= (food.count + food.food.count)%>"
                disabled
              />
            </strong>
            Price: <strike style="color: red">₹<%= food.food.price %></strike>
            ₹<%= 0.6*food.food.price %> <% money = money +
            food.food.price*0.6*food.count %>
          </p>
        </div>
      </div>
    </div>
  </div>
  <% }%>
  <div class="card mb-3 border-0 shadow-sm">
    <div class="card-header bg-white border-0 pb-0">
      <h5 class="mb-0">Select NGO</h5>
    </div>
    <div class="card-body">
    <% for(let NGO of NGOs){ %>
    <div class="form-check mb-3">
      <input
        type="radio"
        value="<%= NGO._id %>"
        name="NGO"
        id="NGO_<%= NGO._id %>"
        class="form-check-input"
        onclick="update(this.value)"
      />
      <label for="NGO_<%= NGO._id %>" class="form-check-label w-100">
      <div class="card mt-2 border">
        <div class="row g-0">
          <div class="col-md-3 d-flex align-items-center justify-content-center p-2">
            <%if(NGO.image.url) {%>
            <img class="img-fluid" alt="" src="<%=NGO.image.url%>" />
            <% }else {%>
            <img
              class="img-fluid"
              alt=""
              src="https://acadianakarate.com/wp-content/uploads/2017/04/default-image-620x600.jpg"
            />
            <% } %>
          </div>
          <div class="col-md-9">
            <div class="card-body">
              <h5 class="card-title"><%= NGO.username %></h5>
              <p class="card-text">
                <small class="text-muted d-block"><%= NGO.location%></small>
              </p>
            </div>
          </div>
        </div>
      </div>
      </label>
    </div>
    <% } %>
    </div>
    <div class="row g-0 border-top">
      <div class="col-md-4">
        <div class="card-body">
          <strong>Total Amount: ₹<%= money %> </strong>
        </div>
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <button class="btn btn-success" id="rzp-button1" disabled>
            Submit Donation
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  const headers = {
    'Content-Type': 'application/json',
  };
  let data = {};
  // Update NGO
  function update(NGO_id) {
    data = {
      amount: '<%-money%>',
      NGO: NGO_id,
    };
    document.getElementById('rzp-button1').disabled = false;
  }
  // Pay Food
  document.getElementById('rzp-button1').onclick = function (e) {
    e.preventDefault();
    console.log(data);
    axios
      .post('/cart/pay/donate', data, {
        headers: headers,
      })
      .then((info) => {
        var options = {
          key: '<%-process.env.RAZORPAY_KEY%>', // Enter the Key ID generated from the Dashboard
          name: '<%-currentUser.username%>',
          description: 'Test Transaction',
          image: '<%-currentUser.image.url%>',
          order_id: info.data.id,
          callback_url: '/cart',
          theme: {
            color: '#3399cc',
          },
        };
        var rzp1 = new Razorpay(options);
        rzp1.on('payment.failed', function (response) {
          axios.post('/cart/payment/failed', {
            razorpay_order_id: response.error && response.error.metadata && response.error.metadata.order_id,
          }, { headers });
        });
        rzp1.open();
      });
  };
</script>
