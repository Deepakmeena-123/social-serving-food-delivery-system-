<% layout('layouts/boilerplate') %>

<div class="ngo-dashboard container py-4">

  <div class="row g-4 align-items-start">


    <aside class="col-lg-3">

      <div class="restaurant-sidebar card border-0 shadow-sm h-100">

        <div class="card-body p-3">

          <div class="restaurant-brand mb-4">

            <div class="restaurant-brand-icon">
              FB
            </div>

            <div>

              <h5 class="mb-0">
                FoodBridge
              </h5>

              <small class="text-muted">
                NGO Panel
              </small>

            </div>

          </div>


          <nav class="nav flex-column restaurant-nav">

            <a
              class="nav-link"
              href="/ngo/dashboard"
            >
              <i class="bi bi-grid-1x2-fill"></i>
              Dashboard
            </a>


            <a
              class="nav-link active"
              href="/receiveddonations"
            >
              <i class="bi bi-inbox"></i>
              Donation Requests
            </a>


            <a
              class="nav-link"
              href="/receiveddonations/received"
            >
              <i class="bi bi-check2-square"></i>
              Received Donations
            </a>


            <a
              class="nav-link"
              href="/donationhistory"
            >
              <i class="bi bi-clock-history"></i>
              Donation History
            </a>


            <a
              class="nav-link"
              href="/profile/<%= currentUser._id %>"
            >
              <i class="bi bi-person-circle"></i>
              Profile
            </a>


            <a
              class="nav-link text-danger"
              href="/logout"
            >
              <i class="bi bi-box-arrow-right"></i>
              Logout
            </a>

          </nav>

        </div>

      </div>

    </aside>


    <main class="col-lg-9">


      <div class="mb-4">

        <p class="text-muted mb-1">
          Incoming requests
        </p>

        <h1 class="mb-0">
          Donation Requests
        </h1>

        <p class="text-muted mt-2 mb-0">

          Accept a donation to allow the restaurant
          to start processing the food.

        </p>

      </div>


      <% if (
        !donations ||
        donations.length === 0
      ) { %>


        <div
          class="card border-0 shadow-sm"
        >

          <div
            class="card-body text-center py-5 text-muted"
          >

            <i
              class="bi bi-inbox fs-2 d-block mb-2"
            ></i>

            No pending donations found.

          </div>

        </div>


      <% } else { %>


        <div
          class="card border-0 shadow-sm"
        >

          <div class="table-responsive">

            <table
              class="table align-middle mb-0"
            >

              <thead class="table-light">

                <tr>

                  <th>
                    Food
                  </th>

                  <th>
                    Donor
                  </th>

                  <th>
                    Quantity
                  </th>

                  <th>
                    Date
                  </th>

                  <th>
                    Status
                  </th>

                  <th>
                    Action
                  </th>

                </tr>

              </thead>


              <tbody>


                <% for (
                  const donation of donations
                ) { %>


                  <tr>


                    <td>

                      <strong>
                        <%= donation.foodName ||
                          'N/A'
                        %>
                      </strong>

                    </td>


                    <td>

                      <%= donation.donorName ||
                        (
                          donation.donorId &&
                          donation.donorId.username
                        ) ||
                        'Unknown'
                      %>

                    </td>


                    <td>
                      <%= donation.donatedQuantity %>
                    </td>


                    <td>

                      <%= donation.donationDate
                        ? new Date(
                            donation.donationDate
                          ).toLocaleDateString(
                            'en-IN',
                            {
                              day: '2-digit',
                              month: 'short',
                              year: 'numeric'
                            }
                          )
                        : 'N/A'
                      %>

                    </td>


                    <td>

                      <span
                        class="badge bg-warning text-dark px-3 py-2"
                      >
                        Pending
                      </span>

                    </td>


                    <td>

                      <div
                        class="d-flex gap-2"
                      >

                        <form
                          action="/receiveddonations/<%= donation._id %>/accept"
                          method="POST"
                        >

                          <button
                            type="submit"
                            class="btn btn-sm btn-success"
                          >
                            Accept
                          </button>

                        </form>


                        <form
                          action="/receiveddonations/<%= donation._id %>/reject"
                          method="POST"
                        >

                          <button
                            type="submit"
                            class="btn btn-sm btn-outline-danger"
                          >
                            Reject
                          </button>

                        </form>

                      </div>

                    </td>


                  </tr>


                <% } %>


              </tbody>

            </table>

          </div>

        </div>


      <% } %>


    </main>

  </div>

</div>