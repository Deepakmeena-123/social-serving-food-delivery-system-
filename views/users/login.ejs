<% layout('layouts/authBoilerplate') %>
<div class="auth-card">
  <div class="auth-brand-row">
    <a href="/" class="auth-brand" aria-label="FoodBridge home">
      <img src="/images/foodbridge-logo.png" alt="FoodBridge logo" />
      <span>FoodBridge</span>
    </a>
  </div>

  <h2 class="auth-title">Log in</h2>

  <form class="login-form validated-form" action="/login" method="POST" novalidate>
    <div>
      <label for="username">Username</label>
      <input class="form-control" id="username" type="text" placeholder="Username" name="username" required />
      <div class="valid-feedback">Looks good!</div>
    </div>

    <div>
      <label for="password">Password</label>
      <input class="form-control" id="password" type="password" placeholder="Password" name="password" required />
      <div class="valid-feedback">Looks good!</div>
    </div>

    <button class="login-btn btn--form" type="submit" value="Log in">Log in</button>
  </form>

  <div class="auth-switch">
    Not a User? <a href="/register" id="linkInlogin">Sign Up</a>
  </div>
</div>