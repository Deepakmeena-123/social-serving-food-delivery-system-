<% layout('layouts/boilerplate') %>

<div class="customer-dashboard container py-4">
  <div class="row g-4 align-items-start">
    <aside class="col-lg-3">
      <div class="restaurant-sidebar card border-0 shadow-sm h-100">
        <div class="card-body p-3">
          <div class="restaurant-brand mb-4">
            <div class="restaurant-brand-icon">FB</div>
            <div>
              <h5 class="mb-0">FoodBridge</h5>
              <small class="text-muted">Customer Panel</small>
            </div>
          </div>

          <nav class="nav flex-column restaurant-nav">
            <a class="nav-link active" href="/customer/dashboard"><i class="bi bi-grid-1x2-fill"></i> Home</a>
            <a class="nav-link" href="/restaurants"><i class="bi bi-shop"></i> Restaurants</a>
            <a class="nav-link" href="/orderhistory"><i class="bi bi-bag-check"></i> Orders</a>
            <a class="nav-link" href="/customer/donations/history"><i class="bi bi-gift"></i> Donations</a>
            <a class="nav-link" href="/cart"><i class="bi bi-cart3"></i> Cart</a>
            <a class="nav-link" href="/profile/<%= customer._id %>"><i class="bi bi-person-circle"></i> Profile</a>
            <a class="nav-link text-danger" href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
          </nav>
        </div>
      </div>
    </aside>

    <main class="col-lg-9">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <p class="text-muted mb-1">Welcome back</p>
          <h1 class="mb-0"><%= customer.username %></h1>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
          <div class="card dashboard-stat-card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="stat-top">
                <span class="stat-label">Total Orders</span>
                <span class="stat-icon green"><i class="bi bi-receipt"></i></span>
              </div>
              <h3 class="mt-3 mb-0"><%= totalOrders %></h3>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-xl-3">
          <div class="card dashboard-stat-card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="stat-top">
                <span class="stat-label">Pending Orders</span>
                <span class="stat-icon orange"><i class="bi bi-hourglass-split"></i></span>
              </div>
              <h3 class="mt-3 mb-0"><%= pendingOrders %></h3>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-xl-3">
          <div class="card dashboard-stat-card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="stat-top">
                <span class="stat-label">Total Donations</span>
                <span class="stat-icon green"><i class="bi bi-gift-fill"></i></span>
              </div>
              <h3 class="mt-3 mb-0"><%= totalDonations %></h3>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-xl-3">
          <div class="card dashboard-stat-card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="stat-top">
                <span class="stat-label">Cart Items</span>
                <span class="stat-icon orange"><i class="bi bi-cart-check"></i></span>
              </div>
              <h3 class="mt-3 mb-0"><%= cartItems %></h3>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
              <h5 class="mb-0">Recent Orders</h5>
              <a href="/orderhistory" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table mb-0 align-middle">
                  <thead class="table-light">
                    <tr>
                      <th>Order</th>
                      <th>Restaurant</th>
                      <th>Amount</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!recentOrders || recentOrders.length === 0) { %>
                      <tr>
                        <td colspan="4" class="text-center text-muted py-4">No orders found.</td>
                      </tr>
                    <% } else { %>
                      <% for (const order of recentOrders) { %>
                        <tr>
                          <td>#<%= order._id.toString().slice(-6) %></td>
                          <td><%= order.order && order.order[0] && order.order[0].food && order.order[0].food.restaurant ? order.order[0].food.restaurant.username : 'N/A' %></td>
                          <td>₹<%= order.money || 0 %></td>
                          <td>
                            <% if (order.status === 'Success' || order.status === 'Delivered') { %>
                              <span class="badge bg-success"><%= order.status %></span>
                            <% } else if (order.status === 'Pending') { %>
                              <span class="badge bg-warning text-dark">Pending</span>
                            <% } else if (order.status === 'Cancelled' || order.status === 'Failed') { %>
                              <span class="badge bg-danger"><%= order.status %></span>
                            <% } else { %>
                              <span class="badge bg-secondary"><%= order.status %></span>
                            <% } %>
                          </td>
                        </tr>
                      <% } %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
              <h5 class="mb-0">Recent Donations</h5>
              <a href="/customer/donations/history" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            <div class="card-body p-0">
              <div class="list-group list-group-flush">
                <% if (!recentDonations || recentDonations.length === 0) { %>
                  <div class="p-3 text-muted text-center">No donations found.</div>
                <% } else { %>
                  <% for (const donationOrder of recentDonations) { %>
                    <div class="list-group-item">
                      <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                          <strong><%= donationOrder.NGO ? donationOrder.NGO.username : 'NGO' %></strong>
                          <div class="small text-muted"><%= donationOrder.order ? donationOrder.order.length : 0 %> item(s)</div>
                        </div>
                        <span class="badge bg-light text-dark">₹<%= donationOrder.money || 0 %></span>
                      </div>
                    </div>
                  <% } %>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
