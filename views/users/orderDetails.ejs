<% layout('layouts/boilerplate') %>

<div class="container py-4 customer-order-details">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <p class="text-muted mb-1">Order details</p>
      <h1 class="mb-0">Order #<%= order._id.toString().slice(-6) %></h1>
    </div>
    <a href="/orderhistory" class="btn btn-outline-secondary">Back to Orders</a>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <p class="mb-1 text-muted">Payment Method</p>
          <strong><%= order.modeOfPayment || 'N/A' %></strong>
        </div>
        <div class="col-md-4">
          <p class="mb-1 text-muted">Payment Status</p>
          <strong><%= order.paymentStatus || (order.modeOfPayment === 'COD' ? 'COD' : order.status === 'Success' ? 'Paid' : order.status === 'Failed' ? 'Failed' : 'Pending') %></strong>
        </div>
        <div class="col-md-4">
          <p class="mb-1 text-muted">Status</p>
          <strong><%= order.status || 'N/A' %></strong>
        </div>
        <div class="col-md-4">
          <p class="mb-1 text-muted">Total Amount</p>
          <strong>₹<%= order.money || 0 %></strong>
        </div>
        <div class="col-md-4">
          <p class="mb-1 text-muted">Order Date</p>
          <strong><%= new Date(order._id.getTimestamp()).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></strong>
        </div>
        <div class="col-md-8">
          <p class="mb-1 text-muted">Delivery Address</p>
          <strong><%= order.user && order.user.location ? order.user.location : 'N/A' %></strong>
        </div>
        <div class="col-md-6">
          <p class="mb-1 text-muted">Customer</p>
          <strong><%= order.user ? order.user.username : 'N/A' %></strong>
        </div>
        <div class="col-md-6">
          <p class="mb-1 text-muted">NGO</p>
          <strong><%= order.NGO ? order.NGO.username : 'Not selected' %></strong>
        </div>
      </div>
    </div>
  </div>

  <% if (currentUser && currentUser.roles === 'customer' && order.status === 'OutForDelivery') { %>
    <form action="/orderhistory/<%= order._id %>/received" method="POST" class="mb-4">
      <button class="btn btn-success">I Received My Order</button>
    </form>
  <% } %>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3">
      <h5 class="mb-0">Ordered Food Items</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Food</th>
              <th>Restaurant</th>
              <th>Quantity</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            <% for (let item of order.order) { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <img src="<%= item.food && item.food.image && item.food.image.url ? item.food.image.url : 'https://openclipart.org/image/800px/289282' %>" alt="food" class="rounded" style="width: 44px; height: 44px; object-fit: cover;" />
                    <span><%= item.food && item.food.name ? item.food.name : 'N/A' %></span>
                  </div>
                </td>
                <td><%= item.food && item.food.restaurant ? item.food.restaurant.username : 'N/A' %></td>
                <td><%= item.count || 0 %></td>
                <td>₹<%= item.money || 0 %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
