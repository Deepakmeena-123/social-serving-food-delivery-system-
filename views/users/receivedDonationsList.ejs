<% layout('layouts/boilerplate') %>

<div class="ngo-dashboard container py-4">

  <div class="row g-4 align-items-start">

    <!-- =========================================================
         NGO SIDEBAR
    ========================================================== -->
    <aside class="col-lg-3">

      <div class="restaurant-sidebar card border-0 shadow-sm h-100">

        <div class="card-body p-3">

          <div class="restaurant-brand mb-4">

            <div class="restaurant-brand-icon">
              FB
            </div>

            <div>
              <h5 class="mb-0">FoodBridge</h5>
              <small class="text-muted">NGO Panel</small>
            </div>

          </div>


          <nav class="nav flex-column restaurant-nav">

            <a
              class="nav-link"
              href="/ngo/dashboard"
            >
              <i class="bi bi-grid-1x2-fill"></i>
              Dashboard
            </a>


            <a
              class="nav-link"
              href="/receiveddonations"
            >
              <i class="bi bi-inbox"></i>
              Donation Requests
            </a>


            <a
              class="nav-link active"
              href="/receiveddonations/received"
            >
              <i class="bi bi-check2-square"></i>
              Received Donations
            </a>


            <a
              class="nav-link"
              href="/donationhistory"
            >
              <i class="bi bi-clock-history"></i>
              Donation History
            </a>


            <a
              class="nav-link"
              href="/profile/<%= currentUser._id %>"
            >
              <i class="bi bi-person-circle"></i>
              Profile
            </a>


            <a
              class="nav-link text-danger"
              href="/logout"
            >
              <i class="bi bi-box-arrow-right"></i>
              Logout
            </a>

          </nav>

        </div>

      </div>

    </aside>


    <!-- =========================================================
         MAIN CONTENT
    ========================================================== -->
    <main class="col-lg-9">

      <div class="mb-4">

        <p class="text-muted mb-1">
          Accepted donations and delivery tracking
        </p>

        <h1 class="mb-0">
          Received Donations
        </h1>

      </div>


      <!-- =======================================================
           DONATIONS TABLE
      ======================================================== -->

      <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

          <div class="table-responsive">

            <table class="table align-middle mb-0">

              <thead class="table-light">

                <tr>

                  <th>Food</th>

                  <th>Donor Name</th>

                  <th>Donor Type</th>

                  <th>Quantity</th>

                  <th>Date</th>

                  <th>Donation Status</th>

                  <th>Delivery Status</th>

                  <th>Action</th>

                </tr>

              </thead>


              <tbody>

                <% if (!donations || donations.length === 0) { %>

                  <tr>

                    <td
                      colspan="8"
                      class="text-center text-muted py-5"
                    >

                      <div class="mb-2">
                        <i class="bi bi-inbox fs-3"></i>
                      </div>

                      <div>
                        No received donations found.
                      </div>

                    </td>

                  </tr>

                <% } else { %>


                  <% for (const donation of donations) { %>

                    <%
                      const donationDate =
                        donation.donationDate
                          ? new Date(donation.donationDate)
                          : null;

                      const deliveryStatus =
                        donation.deliveryStatus || 'Pending';

                      const donationStatus =
                        donation.status || 'Pending';
                    %>


                    <tr>

                      <!-- FOOD -->
                      <td>

                        <strong>
                          <%= donation.foodName || 'Food Item' %>
                        </strong>

                      </td>


                      <!-- DONOR -->
                      <td>

                        <%= donation.donorId
                          ? donation.donorId.username
                          : (donation.donorName || 'Customer')
                        %>

                      </td>


                      <!-- DONOR TYPE -->
                      <td>

                        <span class="badge bg-light text-dark">

                          <%= donation.donorType || 'Customer' %>

                        </span>

                      </td>


                      <!-- QUANTITY -->
                      <td>

                        <%= donation.donatedQuantity || 0 %>

                      </td>


                      <!-- DATE -->
                      <td>

                        <%= donationDate
                          ? donationDate.toLocaleDateString('en-IN', {
                              day: '2-digit',
                              month: 'short',
                              year: 'numeric'
                            })
                          : 'N/A'
                        %>

                      </td>


                      <!-- =================================================
                           DONATION STATUS
                      ================================================== -->
                      <td>

                        <% if (donationStatus === 'Accepted') { %>

                          <span class="badge bg-primary">
                            Accepted
                          </span>

                        <% } else if (donationStatus === 'Received') { %>

                          <span class="badge bg-success">
                            Received
                          </span>

                        <% } else if (donationStatus === 'Completed') { %>

                          <span class="badge bg-success">
                            Completed
                          </span>

                        <% } else if (donationStatus === 'Rejected') { %>

                          <span class="badge bg-danger">
                            Rejected
                          </span>

                        <% } else { %>

                          <span class="badge bg-warning text-dark">
                            <%= donationStatus %>
                          </span>

                        <% } %>

                      </td>


                      <!-- =================================================
                           DELIVERY STATUS
                      ================================================== -->
                      <td>

                        <% if (deliveryStatus === 'Pending') { %>

                          <span class="badge bg-warning text-dark">
                            Pending
                          </span>

                        <% } else if (deliveryStatus === 'Preparing') { %>

                          <span class="badge bg-primary">
                            Preparing
                          </span>

                        <% } else if (deliveryStatus === 'OutForDelivery') { %>

                          <span class="badge bg-info text-dark">
                            Out for Delivery
                          </span>

                        <% } else if (
                          deliveryStatus === 'Delivered'
                        ) { %>

                          <span class="badge bg-success">
                            Delivered
                          </span>

                        <% } else if (
                          deliveryStatus === 'Cancelled'
                        ) { %>

                          <span class="badge bg-danger">
                            Cancelled
                          </span>

                        <% } else { %>

                          <span class="badge bg-secondary">
                            <%= deliveryStatus %>
                          </span>

                        <% } %>

                      </td>


                      <!-- =================================================
                           ACTION
                      ================================================== -->
                      <td>

                        <!--
                          NGO can receive the food ONLY after
                          restaurant marks it OutForDelivery.
                        -->

                        <% if (
                          donationStatus === 'Accepted' &&
                          deliveryStatus === 'OutForDelivery'
                        ) { %>


                          <form
                            action="/receiveddonations/<%= donation._id %>/received"
                            method="POST"
                            class="m-0"
                          >

                            <button
                              type="submit"
                              class="btn btn-success btn-sm"
                            >

                              <i class="bi bi-check-circle me-1"></i>

                              I Received Donation

                            </button>

                          </form>


                        <% } else if (
                          donationStatus === 'Received' ||
                          deliveryStatus === 'Delivered'
                        ) { %>


                          <span class="badge bg-success">

                            <i class="bi bi-check-circle me-1"></i>

                            Received

                          </span>


                        <% } else if (
                          deliveryStatus === 'Pending'
                        ) { %>


                          <span class="text-muted small">

                            Waiting for restaurant delivery

                          </span>


                        <% } else if (
                          deliveryStatus === 'Preparing'
                        ) { %>


                          <span class="text-muted small">

                            Restaurant is preparing food

                          </span>


                        <% } else { %>


                          <span class="text-muted small">
                            —
                          </span>


                        <% } %>

                      </td>

                    </tr>

                  <% } %>

                <% } %>

              </tbody>

            </table>

          </div>

        </div>

      </div>

    </main>

  </div>

</div>