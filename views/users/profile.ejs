<% layout('layouts/boilerplate')%>
<!-- Profile Page -->
<div class="customer-profile-page py-3">
  <div class="row g-4 align-items-start">
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm customer-profile-card">
        <div class="card-body">
          <div class="text-center mb-3">
            <img src="<%= user.image && user.image.url ? user.image.url : 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_960_720.png' %>" alt="profile" class="customer-profile-avatar mb-2" />
            <h4 class="mb-0"><%= user.username %></h4>
            <small class="text-muted"><%= user.roles ? user.roles.toUpperCase() : 'USER' %></small>
          </div>

          <div class="mb-2">
            <div class="customer-profile-key">Email</div>
            <div class="customer-profile-value"><%= user.email || 'Not provided' %></div>
          </div>

          <div class="mb-2">
            <div class="customer-profile-key">Phone</div>
            <div class="customer-profile-value"><%= user.contactNumber || 'Not provided' %></div>
          </div>

          <div class="mb-2">
            <div class="customer-profile-key">Location</div>
            <% if(currentUser && currentUser._id.equals(user._id)) { %>
              <form action="/edit?_method=PUT" method="post" class="mt-1">
                <input
                  class="form-control mb-2"
                  type="text"
                  id="location"
                  name="location"
                  value="<%= user.location%>"
                  required
                />
                <button class="btn btn-primary btn-sm">Save Changes</button>
              </form>
            <% } else { %>
              <div class="customer-profile-value"><%= user.location || 'Not provided' %></div>
            <% } %>
          </div>

          <% if (user.roles === 'NGO') { %>
            <div class="customer-summary-card p-2 mt-3 bg-light rounded">
              <div class="small text-muted">Total Food Distributed</div>
              <strong><%= totalFoodDistributed %></strong>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h5 class="mb-3">Location Map</h5>
          <div id="map"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
  const user = <%- JSON.stringify(user) %>
</script>

<script src="/javascripts/showPageMap.js"></script>
