<% layout('layouts/boilerplate')%>
<!-- Profile Page -->
<div class="row">
  <div class="col-3">
    <% if(user.image) { %>
    <img src="<%= user.image.url%>" class="d-block w-100" alt="" />
    <% } %>
    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title"><%= user.username%></h5>
        <% if (user.roles === 'NGO') { %>
        <p class="card-text text-muted mb-0">NGO Profile</p>
        <% } %>
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item text-muted">
          Location: <% if(currentUser && currentUser._id.equals(user._id)) { %>
          <form action="/edit?_method=PUT" method="post">
            <input
              class="form-control mb-2"
              type="text"
              id="location"
              name="location"
              value="<%= user.location%>"
              required
            />
            <button class="btn btn-primary">Save Changes</button>
          </form>
          <% } else { %> <%= user.location %> <% } %>
        </li>
        <li class="list-group-item">Role: <%= user.roles.toUpperCase()%></li>
        <% if (user.roles === 'NGO') { %>
        <li class="list-group-item">NGO Name: <%= user.username %></li>
        <li class="list-group-item">Contact Number: <%= user.contactNumber || 'Not provided' %></li>
        <li class="list-group-item">Email: <%= user.email %></li>
        <li class="list-group-item">Member Since: <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></li>
        <li class="list-group-item">Total Food Distributed: <%= totalFoodDistributed %></li>
        <% } %>
      </ul>
    </div>
  </div>
  <div class="col-6">
    <div id="map"></div>
  </div>
</div>

<script>
  const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
  const user = <%- JSON.stringify(user) %>
</script>

<script src="/javascripts/showPageMap.js"></script>
